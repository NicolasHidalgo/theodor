@model webapp.ViewModels.AuxiliarEdit
@{
    ViewBag.Title = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Theme JS files -->
<script type="text/javascript" src="~/assets/js/core/app.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/validation/validate.min.js"></script>
<script type="text/javascript" src="~/assets/js/core/libraries/jquery_ui/interactions.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/tables/datatables/datatables.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/selects/select2.min.js"></script>
<script type="text/javascript" src="~/assets/js/pages/form_select2.js"></script>
<script src="~/assets/otros/inputmask/inputmask.js"></script>

<!-- /theme JS files -->

<link href="~/assets/css/theodor.css" rel="stylesheet" />

<style>
    table thead tr {
        background-color: #3f444e;
        color: white;
    }

    .tit {
        background-color: #156082;
        color: white;
    }
</style>

<div class="modal" id="confirmBorrarModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmación</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Está seguro de eliminar este registro?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmar">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo">Nuevo Registro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form">
                    <div class="row">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Cod. Producto</label>
                                <input type="number" class="form-control" id="txtCodProducto" />
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="form-group">
                                <label>Nom. Producto</label>
                                <input type="text" class="form-control" id="txtNomProducto" />
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Producto Base</label>
                        @*@Html.DropDownList("ddlProductoBase", Model.ddlProducto, new { @class = "select" })*@
                        <select name="ddlProductoBase" id="ddlProductoBase" class="select">
                            @foreach (var item in Model.ddlProducto)
                            {
                                <option value="@item.Value" 
                                        data-aux1="@item.Aux1" 
                                        data-aux2="@item.Aux2" 
                                        data-aux3="@item.Aux3"
                                        data-aux4="@item.Aux4">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Tipo Cliente</label>
                        @Html.DropDownList("ddlTipCliente", Model.ddlTipCliente, new { @multiple = "multiple", @class = "select" })
                    </div>
                    <div class="form-group">
                        <label>Tip. Amortizacion</label>
                        <input type="number" class="form-control hidden" id="txtCodTipAmortizacion" disabled="disabled" />
                        <input type="text" class="form-control" id="txtTipAmortizacion" disabled="disabled" />
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div id="fgPlazo" class="form-group">
                                <label>Plazo</label>
                                <input type="number" class="form-control" id="txtPlazo" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div id="fgTea" class="form-group">
                                <label>TEA</label>
                                <div class="input-group">
                                    <input type="text" id="txtTea" name="txtTea" value="0" class="form-control" style="text-align: right;">
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div id="fgFactorUso" class="form-group">
                                <label>Factor Uso Linea</label>
                                <div class="input-group">
                                    <input type="text" id="txtFactorUso" name="txtFactorUso" value="0" class="form-control" style="text-align: right;">
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div id="fgFactorConv" class="form-group">
                                <label>Factor Conversion Indirectos</label>
                                <div class="input-group">
                                    <input type="text" id="txtFactorConversion" name="txtFactorConversion" value="0" class="form-control" style="text-align: right;">
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <input class="form-check-input" type="checkbox" value="" id="chkAplicaPricing">
                        <label class="form-check-label" for="flexCheckChecked">
                            Aplica Pricing
                        </label>
                    </div>

                </div>

            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>*@
                <button type="button" id="btnGrabar" class="btn btn-primary">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<div class="container-fluid">
    <!-- Content area -->
    <div class="content" style="padding-top:0px;">
        <div class="row">
            <div class="col-md-12">
                <!-- Basic layout-->
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <table>
                            <tr>
                                <td class="center"><i class="icon-file-empty icon-custom-style" title="Nuevo" id="btnNuevo"></i><br /><a class="botonera classNuevo">Nuevo</a></td>
                                @*<td class="center"><i class="icon-floppy-disk icon-custom-style " title="Grabar" id="btnGrabar"></i><br /><a class="botonera classGrabar">Grabar</a></td>
                                <td class="center"><i class="icon-bin icon-custom-style " title="Borrar" id="btnBorrar"></i><br /><a class="botonera classBorrar">Borrar</a></td>
                                <td class="center"><i class="icon-search4 icon-custom-style" title="Buscar" id="btnBuscar"></i><br /><a class="botonera classBuscar">Buscar</a></td>*@
                            </tr>
                        </table>


                    </div>

                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">

                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Cód</th>
                                                    <th>Producto</th>
                                                    @*<th>Cod. Producto Base</th>*@
                                                    <th>Producto Base</th>
                                                    <th>Tipo Clientes</th>
                                                    @*<th>Cod. Tipo Amortizacion</th>*@
                                                    <th>Tipo Amortizacion</th>
                                                    <th>Plazo</th>
                                                    <th>TEA</th>
                                                    <th>Factor Uso Linea</th>
                                                    <th>Factor Conversion Indirectos</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyMain">
                                                @{ var odd = 0; var estilo = string.Empty;}
                                                @foreach (var item in Model.producto)
                                                {
                                                    estilo = string.Empty;
                                                    if (item.tipReg.ToUpper().Equals("TIT"))
                                                    {
                                                        odd = 0;
                                                        <tr class="tit">
                                                            <td colspan="11">@item.producto</td>
                                                        </tr>
                                                    }
                                                    if (item.tipReg.ToUpper().Equals("EDT"))
                                                    {
                                                        odd = odd + 1;
                                                        if ((odd % 2) == 0) { estilo = "colorGray"; }

                                            <tr class="@estilo">
                                                <td>@item.codProducto</td>
                                                <td>@item.producto</td>
                                                @*<td>@item.strCodProductoBase</td>*@
                                                <td>@item.productoBase</td>
                                                <td>@item.codTipClientes</td>
                                                @*<td>@item.codTipAmortizacion</td>*@
                                                <td>@item.tipAmortizacion</td>
                                                <td>@item.plazo</td>
                                                <td>@(item.tea?.ToString("P2"))</td>
                                                <td>@(item.factorUsoLinea?.ToString("P2"))</td>
                                                <td>@(item.factorConversionIndirectos?.ToString("P2"))</td>
                                                <td>
                                                    <ul class="icons-list">
                                                        <li class="dropdown">
                                                            <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="icon-menu9"></i></a>
                                                            <ul class="dropdown-menu dropdown-menu-right">
                                                                <li>
                                                                    <a onclick='fSelEditar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item,
Newtonsoft.Json.Formatting.Indented)))'><i class='icon-pencil4'></i> Editar</a>
                                                                </li>
                                                                <li>
                                                                    <a onclick='fSelEliminar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item,
Newtonsoft.Json.Formatting.Indented)))'><i class='icon-bin'></i> Eliminar</a>
                                                                </li>
                                                            </ul>
                                                        </li>
                                                    </ul>
                                                </td>
                                                @*<td width="15%">
                                                                        <a class='btn btn-default' onclick='fSelEditar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item,
        Newtonsoft.Json.Formatting.Indented)))'>Editar</a>&nbsp;<a class='btn btn-default' onclick='fSelEliminar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item,
        Newtonsoft.Json.Formatting.Indented)))'>Eliminar</a>
                                                                    </td>*@
                                            </tr>
                                                    }
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                                <!-- /bordered table -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">

    var fSelEditar;
    var fSelEliminar;


    $(document).ready(function () {
        var gAccion = "";
        var gCod = 0;

        function getPorcentaje(valor) {
            if (isNaN(valor)) {
                return 0;
            }
            let tasa = Number(valor);
            if (tasa == 0) {
                return 0;
            }
            return tasa / 100.0;
        }
        function getPorcentajeNum(valor) {
            if (isNaN(valor)) {
                return 0;
            }
            let tasa = Number(valor);
            if (tasa == 0) {
                return 0;
            }
            return tasa * 100.0;
        }
        function getImporte(valor) {
            let _valor = valor.replace(/,/g, '');
            if (isNaN(_valor)) {
                return 0;
            }
            let monto = Number(_valor);

            return monto;
        }
        function replaceNullEmpty(valor) {
            if (valor == "null" || valor == null || valor == undefined) {
                return "";
            }
            return valor;
        }

        function productoBaseChange() {
            var _codTipAmor = $("#ddlProductoBase option:selected").data('aux1');
            var _tipAmor = $("#ddlProductoBase option:selected").data('aux2');
            var _isFactorUso = $("#ddlProductoBase option:selected").data('aux3');
            var _isFactorConv = $("#ddlProductoBase option:selected").data('aux4');

            if (_isFactorUso == "1") {
                $("#fgFactorUso,#fgTea,#fgPlazo").removeClass('hidden');
            } else {
                $("#fgFactorUso,#fgTea,#fgPlazo").addClass('hidden');
            }
            if (_isFactorConv == "1") {
                $("#fgFactorConv").removeClass('hidden');
            } else {
                $("#fgFactorConv").addClass('hidden');
            }

            $("#txtCodTipAmortizacion").val(_codTipAmor);
            $("#txtTipAmortizacion").val(_tipAmor);
        }

        $("#txtTea,#txtFactorUso,#txtFactorConversion").inputmask({
            alias: "decimal",
            radixPoint: ".",
            digits: "2",
            rightAlign: false,
            integerDigits: 5,
            digitsOptional: true,
            allowPlus: true,
            allowMinus: true,
            placeholder: "0",
            min: 0,
            max: 100,
            numericInput: true,
        });
        //$('#txtPlazo').inputmask({
        //    'alias': 'decimal',
        //    'groupSeparator': ',',
        //    'autoGroup': true,
        //    'digits': 2,
        //    'digitsOptional': false,
        //    'placeholder': '0.00'
        //});

        productoBaseChange();
        $("#ddlProductoBase").change(function (e, data) {
            productoBaseChange();
        });

        fSelEditar = function (data) {
            //console.log(data);
            $('#editModal').modal('show');
            $("#txtCodProducto").val(data.codProducto).change();
            $("#txtNomProducto").val(data.producto).change();
            $("#ddlProductoBase").val(data.strCodProductoBase).change();

            $("#ddlTipCliente option").prop("selected", false);
            let valores = data.codTipClientes.split(",");
            $.each(valores, function (index, item) {
                $("#ddlTipCliente option[value='" + item + "']").prop('selected', true);
            });
            $("#ddlTipCliente").trigger('change');

            var _codTipAmor = $("#ddlProductoBase option:selected").data('aux1');
            var _tipAmor = $("#ddlProductoBase option:selected").data('aux2');

            $("#txtCodTipAmortizacion").val(_codTipAmor);
            $("#txtTipAmortizacion").val(_tipAmor);

            $("#txtPlazo").val(data.plazo).change();
            $("#txtTea").val(getPorcentajeNum(data.tea)).change();
            $("#txtFactorUso").val(getPorcentajeNum(data.factorUsoLinea)).change();
            $("#txtFactorConversion").val(getPorcentajeNum(data.factorConversionIndirectos)).change();
            if (data.aplicaPricing == true) {
                $('#chkAplicaPricing').prop('checked', true);
            } else {
                $('#chkAplicaPricing').prop('checked', false);
            }       

            $('#txtCodProducto').prop('disabled', true);
            $("#titulo").text('Editar Registro');
            gAccion = "UPDATE";
        }
        fSelEliminar = function (data) {
            $('#confirmBorrarModal').modal('show');
            gAccion = "DELETE";
            gCod = data.codProducto;
        }

        $("#btnNuevo,.classNuevo").on("click", function () {
            $("#titulo").text('Nuevo Registro');
            gAccion = "INSERT";
            $("#txtCodProducto, #txtNomProducto, #txtCodTipAmortizacion, #txtPlazo, #txtTea, #txtFactorUso, #txtFactorConversion").val('');
            $('#txtCodProducto').prop('disabled', false);
            $("#ddlTipCliente, #ddlProducto").val('').change();
            $('#editModal').modal('show');

            $('#chkAplicaPricing').prop('checked', true);
            var _codTipAmor = $("#ddlProductoBase option:selected").data('aux1');
            var _tipAmor = $("#ddlProductoBase option:selected").data('aux2');

            $("#txtCodTipAmortizacion").val(_codTipAmor);
            $("#txtTipAmortizacion").val(_tipAmor);
        });
        $("#btnGrabar").on("click", function () {
            fnGrabar();
        });
        $("#btnConfirmar").on("click", function () {
            fnGrabar();
        });

        function fnCargarLista() {
            $.getJSON('@Url.Action("JSON_Producto_Refresh")', function (data) {
                $("#tbodyMain").empty();
                var odd = 0;
                var estilo = "";
                var cadena = "";
                $.each(data, function (index, item) {
                    estilo = "";
                    if (item.tipReg == "TIT") {
                        odd = 0;
                        cadena += "<tr class='tit'><td colspan='11'>" + item.producto +"</td></tr>";
                    }
                    if (item.tipReg == "EDT") {
                        odd = odd + 1;
                        if ((odd % 2) == 0) { estilo = "colorGray"; }
                        cadena += "<tr class=" + estilo + ">";
                        cadena += "<td>" + item.codProducto + "</td>";
                        cadena += "<td>" + item.producto + "</td>";
                        /*cadena += "<td>" + item.strCodProductoBase + "</td>";*/
                        cadena += "<td>" + item.productoBase + "</td>";
                        cadena += "<td>" + item.codTipClientes + "</td>";
                        cadena += "<td>" + item.tipAmortizacion + "</td>";
                        cadena += "<td>" + (item.plazo == null || item.plazo === '' ? '' : item.plazo) + "</td>";
                        cadena += "<td>" + (item.tea == null || item.tea === '' ? '' : numeral(item.tea).format('0.00%')) + "</td>";
                        cadena += "<td>" + (item.factorUsoLinea == null || item.factorUsoLinea === '' ? '' : numeral(item.factorUsoLinea).format('0.00%')) + "</td>";
                        cadena += "<td>" + (item.factorConversionIndirectos == null || item.factorConversionIndirectos === '' ? '' : numeral(item.factorConversionIndirectos).format('0.00%')) + "</td>";

                        cadena += '<td><ul class="icons-list"><li class="dropdown"><a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="icon-menu9"></i></a>';
                        cadena += '<ul class="dropdown-menu dropdown-menu-right">';
                        cadena += "<li><a onclick='fSelEditar(" + JSON.stringify(item) + ")'><i class='icon-pencil4'></i> Editar</a></li>";
                        cadena += "<li><a onclick='fSelEliminar(" + JSON.stringify(item) + ")'><i class='icon-bin'></i> Eliminar</a></li>";
                        cadena += '</ul></li></ul></td>';

                        //cadena += "<td width='15%'><a class='btn btn-default' onclick='fSelEditar(" + JSON.stringify(item) + ")'>Editar</a>&nbsp;<a class='btn btn-default' onclick='fSelEliminar(" + JSON.stringify(item) + ")'>Eliminar</a></td>";
                        cadena += "</tr>";
                    }
                });
                $("#tbodyMain").append(cadena);
            }).done(function () {

            });
        }

        function fnGrabar() {
            $("#overlay").show();
            var arrTipoCliente = [];
            var _tipCli = $('#ddlTipCliente').val();
            if (_tipCli != null) {
                $.map(_tipCli, function (item) {
                    arrTipoCliente.push(item);
                    
                    //arrTipoCliente.push({ ID_PERFIL: Number(item) });
                    //if (item) {
                    //    return {
                    //        Value: Number(item)
                    //    }
                    //}
                });
            }

            isAplica = false;
            if ($('#chkAplicaPricing').prop('checked')) {
                isAplica = true;
            }

            var _obj = {
                codProducto: gAccion == "DELETE" ? gCod : $("#txtCodProducto").val(),
                producto: $("#txtNomProducto").val(),
                strCodProductoBase: $("#ddlProductoBase option:selected").val(),
                codTipClientes: arrTipoCliente.join(','),
                codTipAmortizacion: $("#txtCodTipAmortizacion").val(),
                plazo: $("#txtPlazo").val(),
                tea: getPorcentaje($("#txtTea").val()),
                factorUsoLinea: getPorcentaje($("#txtFactorUso").val()),
                factorConversionIndirectos: getPorcentaje($("#txtFactorConversion").val()),
                aplicaPricing: isAplica,
            };

            var _reply = {
                ACCION: gAccion,
                MENSAJE: '',
                DATA: JSON.stringify(_obj),
            };

            var _url = '@Url.Action("EditProducto", "MANT")';
            $.post(_url, _reply).done(function (data) {
                if (data.Status === 200) {
                    toastr.success(data.Message);
                    fnCargarLista();
                    //PlantillaDataTable.draw();
                }
                else {
                    toastr.error(data.Message);
                }
            }).fail(function (e) {
            }).always(function () {
                $("#overlay").hide();
                if (gAccion == "DELETE") {
                    $('#confirmBorrarModal').modal('hide');
                } else {
                    $('#editModal').modal('hide');
                }

            });
        }
    });

</script>