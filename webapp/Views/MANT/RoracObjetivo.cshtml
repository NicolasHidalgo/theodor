@model webapp.ViewModels.AuxiliarEdit
@{
    ViewBag.Title = "RoracObjetivo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Theme JS files -->
<script type="text/javascript" src="~/assets/js/core/app.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/validation/validate.min.js"></script>
<script type="text/javascript" src="~/assets/js/core/libraries/jquery_ui/interactions.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/tables/datatables/datatables.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/selects/select2.min.js"></script>
<script type="text/javascript" src="~/assets/js/pages/form_select2.js"></script>
<script src="~/assets/otros/inputmask/inputmask.js"></script>

<!-- /theme JS files -->

<link href="~/assets/css/theodor.css" rel="stylesheet" />

<style>
    table thead tr {
        background-color: #3f444e;
        color: white;
    }

    .tit {
        background-color: #156082;
        color: white;
    }
</style>

<div class="modal" id="confirmBorrarModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmación</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Está seguro de eliminar este registro?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmar">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="editModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo">Nuevo Registro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="form">
                    <div class="form-group">
                        <label>Personería</label>
                        @Html.DropDownList("ddlPersoneria", Model.ddlPersoneria, new { @class = "select" })
                    </div>
                    <div class="form-group">
                        <label>Tipo Cliente</label>
                        @*@Html.DropDownList("ddlTipCliente", Model.ddlTipCliente, new { @class = "select" })*@
                        <select id="ddlTipCliente" class="select"></select>
                    </div>
                    <div class="form-group">
                        <label>Producto</label>
                        @*@Html.DropDownList("ddlProducto", Model.ddlProducto, new { @class = "select" })*@
                        <select id="ddlProducto" class="select"></select>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Rorac Objetivo</label>
                                <div class="input-group">
                                    <input type="text" id="txtRORACObjetivo" name="txtRORACObjetivo" value="0" class="form-control" style="text-align: right;">
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Autonomia Comercial</label>
                                <div class="input-group">
                                    <input type="text" id="txtAutonomiaComercial" name="txtAutonomiaComercial" value="0" class="form-control" style="text-align: right;">
                                    <span class="input-group-addon">%</span>
                                </div>
                            </div>
                        </div>
                    </div>



                </div>

            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>*@
                <button type="button" id="btnGrabar" class="btn btn-primary">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<div class="container-fluid">
    <!-- Content area -->
    <div class="content" style="padding-top:0px;">
        <div class="row">
            <div class="col-md-12">
                <!-- Basic layout-->
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <table>
                            <tr>
                                <td class="center"><i class="icon-file-empty icon-custom-style" title="Nuevo" id="btnNuevo"></i><br /><a class="botonera classNuevo">Nuevo</a></td>
                                <!--<td class="center"><i class="icon-floppy-disk icon-custom-style " title="Grabar" id="btnGrabar"></i><br /><a class="botonera classGrabar">Grabar</a></td>-->
                                <!--<td class="center"><i class="icon-bin icon-custom-style " title="Borrar" id="btnBorrar"></i><br /><a class="botonera classBorrar">Borrar</a></td>-->
                                @*<td class="center"><i class="icon-search4 icon-custom-style" title="Buscar" id="btnBuscar"></i><br /><a class="botonera classBuscar">Buscar</a></td>*@
                            </tr>
                        </table>


                    </div>

                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="form-group">

                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Cod. Personeria</th>
                                                    <th>Cod. Tipo Cliente</th>
                                                    <th>Tipo Cliente</th>
                                                    <th>Cod. Producto</th>
                                                    <th>Producto</th>
                                                    <th>RORAC Objetivo</th>
                                                    <th>Autonomia Comercial</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyRORAC">
                                                @{ var odd = 0; var estilo = string.Empty;}
                                                @foreach (var item in Model.mantRorac)
                                                {
                                                    estilo = string.Empty;
                                                    if (item.tipReg.ToUpper().Equals("TIT"))
                                                    {
                                                        odd = 0;
                                                        <tr class="tit">
                                                            <td colspan="8">@item.tipCliente</td>
                                                        </tr>
                                                    }
                                                    if (item.tipReg.ToUpper().Equals("EDT"))
                                                    {
                                                        odd = odd + 1;
                                                        if ((odd % 2) == 0) { estilo = "colorGray"; }

                                                        <tr class="@estilo">
                                                            <td>@item.codPersoneria</td>
                                                            <td>@item.codTipCliente</td>
                                                            <td>@item.tipCliente</td>
                                                            <td>@item.codProducto</td>
                                                            <td>@item.producto</td>
                                                            <td>@(item.roracObjetivo?.ToString("P2"))
                                                                @*<input type="text" class="form-control" value="@item.roracObjetivo" />*@
                                                            </td>
                                                            <td>
                                                                @(item.autonomiaComercial?.ToString("P2"))
                                                                @*<input type="text" class="form-control" value="@item.autonomiaComercial" />*@
                                                            </td>
                                                            <td>
                                                                <ul class="icons-list">
                                                                    <li class="dropdown">
                                                                        <a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="icon-menu9"></i></a>
                                                                        <ul class="dropdown-menu dropdown-menu-right">
                                                                            <li><a onclick='fSelEditar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item, 
Newtonsoft.Json.Formatting.Indented)))'><i class='icon-pencil4'></i> Editar</a></li>
                                                                            <li><a onclick='fSelEliminar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item, 
Newtonsoft.Json.Formatting.Indented)))'><i class='icon-bin'></i> Eliminar</a></li>
                                                                        </ul>
                                                                    </li>
                                                                </ul>
                                                            </td>
                                                            @*<td><a class='btn btn-default' onclick='fSelEditar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item, 
Newtonsoft.Json.Formatting.Indented)))'>Editar</a>&nbsp;<a class='btn btn-default' onclick='fSelEliminar(@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item, 
Newtonsoft.Json.Formatting.Indented)))'>Eliminar</a></td>*@
                                                        </tr>
                                                    }
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                                <!-- /bordered table -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">

    var fSelEditar;
    var fSelEliminar;
    var arrTipCliente = [];
    var arrProducto = [];

    $(document).ready(function () {
        var gAccion = "";
        var gCodPersoneria = "";
        var gCodTipCliente = "";
        var gCodProducto = 0;

        var jsModel = @Html.Raw(Json.Encode(Model));
        arrTipCliente = jsModel.ddlTipCliente;
        arrProducto = jsModel.ddlProducto;

        function cargarComboTipCliente() {
            var _codParam = $("#ddlPersoneria option:selected").val();
            var _filtered = arrTipCliente.filter(x => x.Aux1 == _codParam);
            $('#ddlTipCliente').empty();
            $.each(_filtered, function (index, item) {
                $('#ddlTipCliente').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
            cargarComboProducto();
        }
        function cargarComboProducto() {
            var _codParam = $("#ddlTipCliente option:selected").val();
            var _filtered = arrProducto.filter(x => x.Aux1 == _codParam);
            $('#ddlProducto').empty();
            $.each(_filtered, function (index, item) {
                $('#ddlProducto').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
        }
        cargarComboTipCliente();

        $("#ddlPersoneria").change(function (e, data) {
            cargarComboTipCliente();
        });
        $("#ddlTipCliente").change(function (e, data) {
            cargarComboProducto();
        });

        function getPorcentaje(valor) {
            if (isNaN(valor)) {
                return 0;
            }
            let tasa = Number(valor);
            if (tasa == 0) {
                return 0;
            }
            return tasa / 100.0;
        }
        function getPorcentajeNum(valor) {
            if (isNaN(valor)) {
                return 0;
            }
            let tasa = Number(valor);
            if (tasa == 0) {
                return 0;
            }
            return tasa * 100.0;
        }
        function getImporte(valor) {
            let _valor = valor.replace(/,/g, '');
            if (isNaN(_valor)) {
                return 0;
            }
            let monto = Number(_valor);

            return monto;
        }
        function replaceNullEmpty(valor) {
            if (valor == "null" || valor == null || valor == undefined) {
                return "";
            }
            return valor;
        }

        $("#txtRORACObjetivo,#txtAutonomiaComercial").inputmask({
            alias: "decimal",
            radixPoint: ".",
            digits: "6",
            rightAlign: false,
            integerDigits: 5,
            digitsOptional: true,
            allowPlus: true,
            allowMinus: true,
            placeholder: "0",
            min: 0,
            max: 100,
            numericInput: true,
        });

        fSelEditar = function (data) {
            $('#editModal').modal('show');
            $("#ddlPersoneria").val(data.codPersoneria).change();
            $("#ddlTipCliente").val(data.codTipCliente).change();
            $("#ddlProducto").val(data.codProducto).change();
            $("#txtRORACObjetivo").val(getPorcentajeNum(data.roracObjetivo)).change();
            $("#txtAutonomiaComercial").val(getPorcentajeNum(data.autonomiaComercial)).change();

            $('#ddlPersoneria,#ddlTipCliente,#ddlProducto').prop('disabled', true);
            $("#titulo").text('Editar Registro');
            gAccion = "UPDATE";
        }
        fSelEliminar = function (data) {
            $('#confirmBorrarModal').modal('show');
            gAccion = "DELETE";
            //console.log(data)
            gCodPersoneria = data.codPersoneria;
            gCodTipCliente = data.codTipCliente;
            gCodProducto = data.codProducto;
        }

        $("#btnNuevo,.classNuevo").on("click", function () {
            $("#titulo").text('Nuevo Registro');
            gAccion = "INSERT";
            $('#ddlPersoneria,#ddlTipCliente,#ddlProducto').prop('disabled', false);
            $("#txtRORACObjetivo").val('');
            $("#txtAutonomiaComercial").val('');
            $("#ddlPersoneria, #ddlTipCliente, #ddlProducto").val('').change();
            $('#editModal').modal('show');
        });
        $("#btnGrabar").on("click", function () {
            fnGrabar();
        });
        $("#btnConfirmar").on("click", function () {
            fnGrabar();
        });

        function fnCargarLista() {
            $.getJSON('@Url.Action("JSON_RORACObjectivo_Refresh")', function (data) {
                $("#tbodyRORAC").empty();
                var odd = 0;
                var estilo = "";
                var cadena = "";
                $.each(data, function (index, item) {
                    estilo = "";
                    if (item.tipReg == "TIT") {
                        odd = 0;
                        cadena += "<tr class='tit'><td colspan='8'>" + item.tipCliente +"</td></tr>";
                    }
                    if (item.tipReg == "EDT") {
                        odd = odd + 1;
                        if ((odd % 2) == 0) { estilo = "colorGray"; }
                        cadena += "<tr class=" + estilo + ">";
                        cadena += "<td>" + item.codPersoneria + "</td>";
                        cadena += "<td>" + item.codTipCliente + "</td>";
                        cadena += "<td>" + item.tipCliente + "</td>";
                        cadena += "<td>" + replaceNullEmpty(item.codProducto) + "</td>";
                        cadena += "<td>" + item.producto + "</td>";
                        cadena += "<td>" + numeral(item.roracObjetivo).format('0.00%') + "</td>";
                        cadena += "<td>" + numeral(item.autonomiaComercial).format('0.00%') + "</td>";

                        cadena += '<td><ul class="icons-list"><li class="dropdown"><a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="icon-menu9"></i></a>';
                        cadena += '<ul class="dropdown-menu dropdown-menu-right">';
                        cadena += "<li><a onclick='fSelEditar(" + JSON.stringify(item) + ")'><i class='icon-pencil4'></i> Editar</a></li>";
                        cadena += "<li><a onclick='fSelEliminar(" + JSON.stringify(item) + ")'><i class='icon-bin'></i> Eliminar</a></li>";
                        cadena += '</ul></li></ul></td>';

                        //cadena += "<td><a class='btn btn-default' onclick='fSelEditar(" + JSON.stringify(item) + ")'>Editar</a>&nbsp;<a class='btn btn-default' onclick='fSelEliminar(" + JSON.stringify(item) + ")'>Eliminar</a></td>";
                        cadena += "</tr>";
                    }
                });
                $("#tbodyRORAC").append(cadena);
            }).done(function () {

            });
        }

        function fnGrabar() {
            $("#overlay").show();

            var _obj = {
                codPersoneria: gAccion == "DELETE" ? gCodPersoneria : $("#ddlPersoneria option:selected").val(),
                codTipCliente: gAccion == "DELETE" ? gCodTipCliente : $("#ddlTipCliente option:selected").val(),
                codProducto: gAccion == "DELETE" ? gCodProducto : $("#ddlProducto option:selected").val(),
                RORACObjetivo: getPorcentaje($("#txtRORACObjetivo").val()),
                autonomiaComercial: getPorcentaje($("#txtAutonomiaComercial").val()),
            };

            var _reply = {
                ACCION: gAccion,
                MENSAJE: '',
                DATA: JSON.stringify(_obj),
            };

            var _url = '@Url.Action("EditRORACObjetivo", "MANT")';
            $.post(_url, _reply).done(function (data) {
                if (data.Status === 200) {
                    toastr.success(data.Message);
                    fnCargarLista();
                    //PlantillaDataTable.draw();
                }
                else {
                    toastr.error(data.Message);
                }
            }).fail(function (e) {
            }).always(function () {
                $("#overlay").hide();
                if (gAccion == "DELETE") {
                    $('#confirmBorrarModal').modal('hide');
                } else {
                    $('#editModal').modal('hide');
                }

            });
        }
    });

</script>