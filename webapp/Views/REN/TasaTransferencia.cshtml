                                                                        beta0 +
                                                                        beta1 * factor1 +
                                                                        beta2 * factor2 +
                                                                        beta3 * factor3;

                                                                    var encaje = item2.encaje.Value;
                                                                    poolActivo = poolPasivo / (1 - encaje);
                                                                    if (item.tasaSol.HasValue)
