@model webapp.ViewModels.AuxiliarEdit
@{
    ViewBag.Title = "TasaTransferencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Theme JS files -->
<script type="text/javascript" src="~/assets/js/core/app.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/validation/validate.min.js"></script>
<script type="text/javascript" src="~/assets/js/core/libraries/jquery_ui/interactions.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/tables/datatables/datatables.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/selects/select2.min.js"></script>
<script type="text/javascript" src="~/assets/js/pages/form_select2.js"></script>
<script src="~/assets/otros/inputmask/inputmask.js"></script>

<!-- /theme JS files -->
<script src="~/assets/otros/chart/chart.js"></script>
<script src="~/assets/otros/chart/chartjs-plugin-datalabels.js"></script>
<link href="~/assets/css/theodor.css" rel="stylesheet" />

<style>
    table thead tr {
        background-color: #3f444e;
        color: white;
    }

    .tit {
        background-color: #156082;
        color: white;
    }
</style>

<div class="modal" id="confirmBorrarModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmación</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Está seguro de eliminar este registro?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmar">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Main content -->
<div class="container-fluid">
    <!-- Content area -->
    <div class="content" style="padding-top:0px;">
        <div class="row">
            <div class="col-md-12">
                <!-- Basic layout-->
                <div class="panel panel-flat">
                    <div class="panel-heading" style="padding-bottom:0;">
                        <table>
                            <tr>
                                @*<td class="center"><i class="icon-file-empty icon-custom-style" title="Nuevo" id="btnNuevo"></i><br /><a class="botonera classNuevo">Nuevo</a></td>*@
                                <td class="center"><i class="icon-floppy-disk icon-custom-style" title="Grabar" id="btnGrabar"></i><br /><a class="botonera classGrabar">Grabar</a></td>
                                <!--<td class="center"><i class="icon-bin icon-custom-style " title="Borrar" id="btnBorrar"></i><br /><a class="botonera classBorrar">Borrar</a></td>-->
                                @*<td class="center"><i class="icon-search4 icon-custom-style" title="Buscar" id="btnBuscar"></i><br /><a class="botonera classBuscar">Buscar</a></td>*@

                                <td class="center"><i class="icon-database-refresh icon-custom-style" title="Procesar" id="btnProcesar"></i><br /><a class="botonera classGrabar">Procesar</a></td>
                                <td>
                                    <div class="form-group">
                                        <label>Vigencia</label>
                                        <input type="text" class="form-control" id="txtVigencia"  style="text-align: right;"/>
                                        @*<input type="date" class="form-control" id="txtVigencia2" />*@
                                    </div>
                                </td>
                                <td style="width:160px;">
                                    <div class="form-group">
                                        <label>Encaje S/.:</label>
                                        <div class="input-group">
                                            <input type="text" id="txtEncajePEN" name="txtEncajePEN" value="0" class="form-control" style="text-align: right;">
                                            <span class="input-group-addon">%</span>
                                        </div>
                                    </div>
                                </td>
                                <td style="width:160px;">
                                    <div class="form-group">
                                        <label>Encaje US$:</label>
                                        <div class="input-group">
                                            <input type="text" id="txtEncajeUSD" name="txtEncajeUSD" value="0" class="form-control" style="text-align: right;">
                                            <span class="input-group-addon">%</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>


                    </div>

                    <div class="panel-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="form-group">

                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    <th>Meses</th>
                                                    <th>Años</th>
                                                    <th>Tasa S/.</th>
                                                    <th>Pool Fondo S/.</th>
                                                    <th>Tasa US$</th>
                                                    <th>Pool Fondo US$</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbody1">
                                                @{ var odd = 0; var estilo = string.Empty;}
                                                @foreach (var item in Model.lstTasaTranf)
                                                {
                                                    estilo = string.Empty;
                                                    odd = odd + 1;
                                                    if ((odd % 2) == 0) { estilo = "colorGray"; }

                                                    <tr class="@estilo">
                                                        <td align="center">@item.periodo</td>
                                                        <td align="center">@(item.anio?.ToString("N2"))</td>
                                                        <td align="center">@(item.tasaSol?.ToString("P4"))</td>
                                                        <td align="center">@(item.poolFondoSol?.ToString("P4"))</td>
                                                        <td align="center">@(item.tasaUsd?.ToString("P4"))</td>
                                                        <td align="center">@(item.poolFondoUsd?.ToString("P4"))</td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                                <!-- /bordered table -->
                            </div>
                            <div class="col-md-7">
                                <div class="form-group">

                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead>
                                                <tr>
                                                    @*<th>Constantes de Nelson & Siege</th>*@
                                                    <th>Moneda</th>
                                                    <th>beta0</th>
                                                    <th>beta1</th>
                                                    <th>beta2</th>
                                                    <th>beta3</th>
                                                    <th>lambda1</th>
                                                    <th>lambda2</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbody2">
                                                @{ var odd2 = 0; var estilo2 = string.Empty;}
                                                @foreach (var item in Model.lstTasaTranfValor)
                                                {
                                                    estilo2 = string.Empty;
                                                    odd2 = odd2 + 1;
                                                    if ((odd2 % 2) == 0) { estilo2 = "colorGray"; }

                                                    <tr class="@estilo2">
                                                        <td align="left">@item.moneda</td>
                                                        @*<td align="center">@(item.encaje?.ToString("P2"))</td>*@
                                                        <td align="center">@(item.beta0?.ToString("N6"))</td>
                                                        <td align="center">@(item.beta1?.ToString("N6"))</td>
                                                        <td align="center">@(item.beta2?.ToString("N6"))</td>
                                                        <td align="center">@(item.beta3?.ToString("N6"))</td>
                                                        <td align="center">@(item.lambda1?.ToString("N6"))</td>
                                                        <td align="center">@(item.lambda2?.ToString("N6"))</td>
                                                    </tr>
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                                <!-- /bordered table -->
                            
                                <canvas id="myChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">

    var fSelEditar;
    var fSelEliminar;


    $(document).ready(function () {

        function validarTasa(valor) {
            if (valor == "" || valor == 0 || valor == undefined || valor == null) {
                return null;
            }
            return valor;
        }

        function calcularAnios(meses) {
            var res = 0.0;
            if (meses == "" || meses == 0 || meses == undefined || meses == null) {
                return "";
            }
            res = meses / 12;
            return res;
        }
        function calcularPoolPasivo(anios,beta0,beta1,beta2,beta3,lambda1,lambda2) {
            var res = 0.0;
            // Convertir a números explícitamente, en caso de que sean cadenas
            anios = Number(anios);
            beta0 = Number(beta0);
            beta1 = Number(beta1);
            beta2 = Number(beta2);
            beta3 = Number(beta3);
            lambda1 = Number(lambda1);
            lambda2 = Number(lambda2);
            if (lambda1 == "" || lambda1 == 0 || lambda1 == undefined || lambda1 == null) {
                return null;
            }
            if (lambda2 == "" || lambda2 == 0 || lambda2 == undefined || lambda2 == null) {
                return null;
            }

            res = beta0
                + (beta1 * ((1 - Math.exp(-anios / lambda1)) / (anios / lambda1)))
                + (beta2 * (((1 - Math.exp(-anios / lambda1)) / (anios / lambda1)) - Math.exp(-anios / lambda1)))
                + (beta3 * (((1 - Math.exp(-anios / lambda2)) / (anios / lambda2)) - Math.exp(-anios / lambda2)));

            res = (isNaN(res) || !isFinite(res)) ? "" : res;

            return res;
        }
        function calcularPoolActivo(poolPasivo,encaje) {
            var res = 0.0;
            poolPasivo = Number(poolPasivo);
            encaje = Number(encaje);
            res = (poolPasivo / (1 - encaje));
            return res;
        }

        function generarDataGrafico(data, dataValor) {
            /*
            1. 30 items para lograr la curva perfecta
            2. Para el primer ejemplo tenemos 11 datos reales, de los cuales restan 19 y estos tengo que inventar el dato.
            3. Tomar el periodo máximo de los datos reales, para el ejemplo serían 240.
            4. Hacer la formula 240/30 serían 8 meses, entonces los registros tendrían que llenar en 8 en 8 (meses) por ejemplo 8,16,32,...
                ...q pasa sí... el período máximo es 245.. redondear y tomar el entero. Otro caso 267/30 sería 8.9 entonces considerarlo 9.
            5. Para llenar los datos "ficticios" por ejemplo el primero Meses: 8, Año: Calculado (8/12),
                ...Tasa se queda en blanco, Pool Pasivo: formula, Pool Activo Formula.
            */
            var numRegistros = 30;
            var maxPeriodo = 240;
            var intervalo = Math.round(maxPeriodo / numRegistros);
            var colMeses = 0.0;
            var colAnios = 0.0;
            var colTasa = 0.0;
            var colPoolPasivo = 0.0;
            var colPoolActivo = 0.0;
            var arrBase = [];
            const dataBeta = dataValor.filter(x => x.codMoneda == "0");
            var beta0 = dataBeta.map(x => x.beta0);
            var beta1 = dataBeta.map(x => x.beta1);
            var beta2 = dataBeta.map(x => x.beta2);
            var beta3 = dataBeta.map(x => x.beta3);
            var lambda1 = dataBeta.map(x => x.lambda1);
            var lambda2 = dataBeta.map(x => x.lambda1);
            var encaje = dataBeta.map(x => x.encaje);
            //const dataUSD = dataBeta.filter(x => x.codMoneda == "1");

            

            var intervaloAcm = intervalo;
            for (let i = 0; i < numRegistros; i++) {
                colMeses = intervaloAcm;
                colAnios = calcularAnios(intervaloAcm);
                colTasa = validarTasa(null);
                colPoolPasivo = calcularPoolPasivo(colAnios, beta0, beta1, beta2, beta3, lambda1, lambda2);
                colPoolActivo = calcularPoolActivo(colPoolPasivo,encaje);

                arrBase.push({ mes: colMeses, tasa: colTasa, poolPasivo: colPoolPasivo, poolActivo: colPoolActivo });

                intervaloAcm += intervalo;
            }

            data.forEach(function (item) {
                // Encuentra el índice
                let indice = arrBase.findIndex(x => x.mes === item.periodo);
                // Si lo encontramos, eliminamos el elemento
                if (indice !== -1) {
                    arrBase.splice(indice, 1);
                }
                colMeses = item.periodo;
                colAnios = calcularAnios(colMeses);
                colTasa = validarTasa(item.tasaSol);
                colPoolPasivo = calcularPoolPasivo(colAnios, beta0, beta1, beta2, beta3, lambda1, lambda2);
                colPoolActivo = calcularPoolActivo(colPoolPasivo, encaje);

                arrBase.push({ mes: colMeses, tasa: colTasa, poolPasivo: colPoolPasivo, poolActivo: colPoolActivo });
            });

            arrBase.sort(function (a, b) {
                return a.mes - b.mes;
            });

            var labels = arrBase.map(x => x.mes);
            var data1 = arrBase.map(x => x.tasa);
            var data2 = arrBase.map(x => x.poolPasivo);
            var data3 = arrBase.map(x => x.poolActivo);
            debugger;
            construirGrafico(labels, data1, data2, data3);
        }

        function getPorcentaje(valor) {
            if (isNaN(valor)) {
                return 0;
            }
            let tasa = Number(valor);
            if (tasa == 0) {
                return 0;
            }
            return tasa / 100.0;
        }
        function getPorcentajeNum(valor) {
            if (isNaN(valor)) {
                return 0;
            }
            let tasa = Number(valor);
            if (tasa == 0) {
                return 0;
            }
            return tasa * 100.0;
        }
        function getImporte(valor) {
            let _valor = valor.replace(/,/g, '');
            if (isNaN(_valor)) {
                return 0;
            }
            let monto = Number(_valor);

            return monto;
        }
        function replaceNullEmpty(valor) {
            if (valor == "null" || valor == null || valor == undefined) {
                return "";
            }
            return valor;
        }

        $("#txtEncajePEN,#txtEncajeUSD").inputmask({
            alias: "decimal",
            radixPoint: ".",
            digits: "2",
            rightAlign: false,
            integerDigits: 5,
            digitsOptional: true,
            allowPlus: true,
            allowMinus: true,
            placeholder: "0",
            min: 0,
            max: 100,
            numericInput: true,
        });

        var jsModel = @Html.Raw(Json.Encode(Model));
        var dataModel = jsModel.lstTasaTranf.filter(x => x.periodo != "0");
        var periodo = dataModel.map(x => x.periodo);
        var poolFondoUsd = dataModel.map(x => x.poolFondoUsd);
        var poolFondoSol = dataModel.map(x => x.poolFondoSol);
        var tasaSol = dataModel.map(x => x.tasaSol);
        var tasaUsd = dataModel.map(x => x.tasaUsd);
        //var maximoMes = Math.max(...periodo) + 60;

        var dataValor = jsModel.lstTasaTranfValor;
        const dataPEN = dataValor.filter(x => x.codMoneda == "0");
        const dataUSD = dataValor.filter(x => x.codMoneda == "1");

        var encajePEN = dataPEN.map(x => x.encaje);
        var encajeUSD = dataUSD.map(x => x.encaje);
        var vigencia = dataUSD.map(x => x.fecVigencia);
        const timestamp = parseInt(String(vigencia).match(/\d+/)[0]);
        const fecha = new Date(timestamp);

        $("#txtVigencia").val(fecha.toISOString().split('T')[0]);
        /*$("#txtVigencia2").val(vigencia);*/
        $("#txtEncajePEN").val(getPorcentajeNum(encajePEN)).change();
        $("#txtEncajeUSD").val(getPorcentajeNum(encajeUSD)).change();

        generarDataGrafico(dataModel, dataValor);
        //construirGrafico(periodo, poolFondoUsd, poolFondoSol);

        function construirGrafico(labels, data1, data2, data3){
            const data = {
                labels: labels,
                datasets: [
                    {
                        label: 'Tasa',
                        data: data1,
                        borderColor: "yellow",
                        backgroundColor: "yellow",
                        spanGaps: true, // Conectar puntos con valores nulos
                    },
                    {
                        label: 'Pool Pasivo',
                        data: data2,
                        borderColor: "red",
                        backgroundColor: "red",
                    },
                    {
                        label: 'Pool Activo',
                        data: data3,
                        borderColor: "green",
                        backgroundColor: "green",
                    },
                ]
            };


            const ctx = document.getElementById('myChart');
            ctx.height = 200;
            var myChart = new Chart(ctx, {
                type: 'line',
                data: data,
                options: {
                    plugins: {
                        title: {
                            display: true,
                            text: 'Tasa Transferencia',
                            font: {
                                size: 14,
                            }
                        },
                        legend: {
                            position: 'bottom' // Mueve la leyenda debajo del gráfico
                        }
                    },
                    scales: {
                        x: {
                            type: 'linear',
                            //stacked: true,
                            //beginAtZero: true,
                            min: 0,
                            max: 300, //maximoMes,
                            ticks: {
                                stepSize: 50, //maximoMes / 6,
                            },
                        },
                        y: {
                            //stacked: true,
                            //beginAtZero: true,
                            max: .14,
                            min: .0,
                            ticks: {
                                stepSize: .02,
                                callback: function (value) {
                                    return (value * 100).toFixed(0) + '%';
                                },
                            },
                            scaleLabel: {
                                display: true,
                                labelString: 'Porcentaje (%)',
                            },
                        },
                    },

                },
            });
        }

        


    });

</script>