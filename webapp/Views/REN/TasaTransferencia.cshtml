                                                                    var beta3 = item2.beta3.Value;
                                                                    var lambda1 = item2.lambda1.Value;
                                                                    var lambda2 = item2.lambda2.Value;

                                                                    var factor1 = (1 - Math.Exp(-anio / lambda1)) / (anio / lambda1);
                                                                    var factor2 = factor1 - Math.Exp(-anio / lambda1);
                                                                    var factor3 = ((1 - Math.Exp(-anio / lambda2)) / (anio / lambda2)) - Math.Exp(-anio / lambda2);

