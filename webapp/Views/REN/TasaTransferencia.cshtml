        $('.edtPeriodo').on('input', function () {
            var inputActual = $(this);
            var valorIngresado = inputActual.val();
            var id = inputActual.data('id');

            // Busca solo dentro del tbody más cercano
            var $tbody = inputActual.closest('tbody');
            var esRepetido = false;

            $tbody.find('.edtPeriodo').not(this).each(function () {
                if ($(this).val() === valorIngresado) {
                    esRepetido = true;
                    return false; // rompe el each
                }
            });

            if (esRepetido) {
                alert('El periodo "' + valorIngresado + '" ya fue ingresado.');
                inputActual.val('');
                $tbody.find('#lblAnio_' + id).text('');
                return;
            }

            // Si es válido, actualizamos el año
            var periodo = parseFloat(valorIngresado);
            var nuevoAnio = isNaN(periodo) ? '' : calcularAnios(periodo).toFixed(2); // tu lógica
