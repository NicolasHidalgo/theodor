<script type="text/javascript">

    var fSelEditar;
    var fSelEliminar;


    $(document).ready(function () {

        $('input[type="text"]').on('input', function () {
            $("#tdGrabar,#liTab2,#liTab3").addClass("hidden");
            $("#tdProcesar").removeClass("hidden");
            //let nombre = $(this).attr('name') || $(this).attr('id');
            //let valor = $(this).val();
            //console.log(`Cambio en ${nombre}: ${valor}`);
        });

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var target = $(e.target).attr("href") // activated tab
            if (target == "#tab2") {
                generarCurvaTransferencia('PEN');
            }
            if (target == "#tab3") {
                generarCurvaTransferencia('USD');
            }
        });

        $('#btnProcesar').on('click', function () {
            fnCargarConstantes();
        });
        $('#btnGrabar').on('click', function () {
            fnGrabar();
        });

        function generarCurvaTransferencia(codMoneda) {
            var arr = [];

            $('#tbodyTasa tr').each(function () {
                var fila = $(this);

                var periodo = fila.find('input[name="periodo"]').val();
                var tasa = fila.find('input[name="tasa'+codMoneda+'"]').val();

                if (periodo && tasa && Number(periodo) != 0 && Number(tasa) != 0) {
                    arr.push({
                        periodo: Number(periodo),
                        anio: Number(periodo) / 12,
                        tasa: getPorcentaje(tasa)
                    });
                }
            });
            let beta0 = 0.0;
            let beta1 = 0.0;
            let beta2 = 0.0;
            let beta3 = 0.0;
            let lambda1 = 0.0;
            let lambda2 = 0.0;
            let dataBeta = [];
            $('#tbodyValor'+codMoneda+' tr').each(function () {
                var fila = $(this);
                encaje = Number(fila.find('.tdEncaje').text());
                beta0 = Number(fila.find('.tdBeta0').text());
                beta1 = Number(fila.find('.tdBeta1').text());
                beta2 = Number(fila.find('.tdBeta2').text());
                beta3 = Number(fila.find('.tdBeta3').text());
                lambda1 = Number(fila.find('.tdLambda1').text());
                lambda2 = Number(fila.find('.tdLambda2').text());
                dataBeta.push({
                    encaje: encaje,
                    beta0: beta0,
                    beta1: beta1,
                    beta2: beta2,
                    beta3: beta3,
                    lambda1: lambda1,
                    lambda2: lambda2,
                });
            });

            const tbody = $("#tbodyTasa" + codMoneda);
            tbody.empty();

            arr.sort(function (a, b) {
                return a.periodo - b.periodo;
            });

            arr.forEach((item, index) => {
                const estilo = ((index + 1) % 2 === 0) ? "colorGray" : "";
                let poolPasivo = 0.0;
                let poolActivo = 0.0;

                poolPasivo = calcularPoolPasivo(item.anio, beta0, beta1, beta2, beta3, lambda1, lambda2);
                poolActivo = calcularPoolActivo(poolPasivo, encaje);

                const row = `
            <tr class="${estilo}">
                <td align="center">${item.periodo}</td>
                <td align="center">${Number(item.anio).toFixed(2)}</td>
                <td align="center">${getPorcentajeNum(item.tasa).toFixed(4)}%</td>
                <td align="center">${getPorcentajeNum(poolPasivo).toFixed(4)}%</td>
                <td align="center">${getPorcentajeNum(poolActivo).toFixed(4)}%</td>
            </tr>
        `;

                tbody.append(row);
            });

            generarDataGrafico(codMoneda, arr, dataBeta);

        }

        function fnGrabar() {
            $("#overlay").show();

            var lstTasa = [];
            var lstConstante = [];

            $('#tbodyTasa tr').each(function () {
