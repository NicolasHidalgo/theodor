<style>
    .tblTitle {
        text-align: center;
        color: dimgray;
        font-weight: 600;
        font-size: 14px;
    }

    .tblHeader {
        text-align: center;
        color: dimgray;
        font-weight: 600;
    }

    #tblDashboard th {
        height: 15px;
        line-height: 15px;
        padding: 5px;
    }

    #tblDashboard td {
        height: 2px; /* Altura de fila fija */
        /*padding: 0; Elimina relleno interno que aumente la altura */
        line-height: 2px; /* Alinea verticalmente el texto en una sola línea */
        overflow: hidden; /* Evita que el contenido se desborde */
        white-space: nowrap; /* Evita saltos de línea */
        vertical-align: middle; /* Centra verticalmente el contenido */
        box-sizing: border-box; /* Asegura que padding no sume al alto */
    }
</style>

<!-- Main content -->
<div class="container-fluid">
    <!-- Page header -->
    <div class="page-header">
        <div class="page-header-content">
        </div>
        <div class="breadcrumb-line breadcrumb-line-component">
            <ul class="breadcrumb">
                <li><a href="@Url.Action("Index","Home")"><i class="icon-printer position-left"></i> Tablero Control Análisis</a></li>
            </ul>
            <ul class="breadcrumb-elements">
                <li><a id="btnControles"><i class="icon-cogs" title="Controles"></i></a></li>
                @*<li><a id="btnExportar"><i class="icon-file-excel" title="Exportar Excel"></i></a></li>*@
                <li><a id="btnReporte"><i class="icon-printer2" title="Reporte"></i></a></li>
                @*<li><a id="btnCerrar"><i class="icon-lock" title="Cierre"></i></a></li>*@

            </ul>
        </div>
    </div>
    <!-- /page header -->
    <!-- Content area -->
    <div class="content">
        <!-- Page length options -->
        <div id="pControl" class="panel panel-flat">

            <div class="panel-body">
                <div class="col-md-12">

                    <div class="form-group col-md-2">
                        <label>Fec Desde:</label>
                        <input id="txtFecDesde" type="month" class="form-control" />
                    </div>
                    <div class="form-group col-md-2">
                        <label>Fec Hasta:</label>
                        <input id="txtFecHasta" type="month" class="form-control" />
                    </div>

                    <div class="form-group col-md-2">
                        <label>Moneda:</label>
                        <select id="ddlMoneda" name="ddlMoneda" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlMoneda)
                            {
                                @*<option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>*@
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Personeria:</label>
                        <select id="ddlPersoneria" name="ddlPersoneria" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlPersoneria)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Tipo Cliente:</label>
                        <select id="ddlTipCliente" name="ddlTipCliente" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlTipCliente)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Operacion:</label>
                        <select id="ddlOperacion" name="ddlOperacion" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlOperacion)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Producto:</label>
                        <select id="ddlProducto" name="ddlProducto" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlProducto)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Clasificación:</label>
                        <select id="ddlClasificacion" name="ddlClasificacion" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlClasificacionInterna)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Garantia:</label>
                        <select id="ddlGarantia" name="ddlGarantia" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlGarantiaPersonal)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Agencia:</label>
                        <select id="ddlAgencia" name="ddlAgencia" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlAgencia)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Funcionario:</label>
                        <select id="ddlFuncionario" name="ddlFuncionario" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlFuncionario)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>



                </div>
            </div>
        </div>
        <!-- /page length options -->
        <div class="panel panel-flat">
            <div id="reportView" class="img-fluid">
                <div class="row">
                    <div class="col-md-4">
                        <canvas id="chart01"></canvas>
                    </div>
                    <div class="col-md-4">
                        <canvas id="chart02"></canvas>
                    </div>
                    <div class="col-md-4">
                        <canvas id="chart03"></canvas>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <canvas id="chart04"></canvas>
                    </div>
                    <div class="col-md-4">
                        <canvas id="chart05"></canvas>
                    </div>
                    <div class="col-md-4">
                        <canvas id="chart06"></canvas>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4">
                        <canvas id="chart07"></canvas>
                    </div>
                    <div class="col-md-4">
                        <canvas id="chart08"></canvas>
                    </div>
                    <div class="col-md-4">
                        <canvas id="chart09"></canvas>
                    </div>
                </div>
            </div>

        </div>

    </div>
    <!-- /content area -->
</div>
<!-- /main content -->


@section Scripts {
    <script type="text/javascript">

    var arrTipCliente = [];
    var arrProducto = [];
    const charts = {};

    $(document).ready(function () {

        var jsModel = @Html.Raw(Json.Encode(Model));
        arrTipCliente = jsModel.ddlTipCliente;
        arrProducto = jsModel.ddlProducto;

        function cargarComboTipCliente() {
            var _codParam = $("#ddlPersoneria option:selected").val();
            var _filtered = arrTipCliente.filter(x => x.Aux2 == _codParam);
            $('#ddlTipCliente').empty();
            $('#ddlTipCliente').append($('<option/>', {
                value: '',
                text: '--TODOS--',
                selected: true
            }));
            $.each(_filtered, function (index, item) {
                $('#ddlTipCliente').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
            cargarComboProducto();
        }
        function cargarComboProducto() {
            var _codParam = $("#ddlOperacion option:selected").val();
            var _filtered = arrProducto.filter(x => x.Aux2 == _codParam);
            $('#ddlProducto').empty();
            $('#ddlProducto').append($('<option/>', {
                value: '',
                text: '--TODOS--',
                selected: true
            }));
            $.each(_filtered, function (index, item) {
                $('#ddlProducto').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
        }
        cargarComboTipCliente();

        $("#ddlPersoneria").change(function (e, data) {
            cargarComboTipCliente();
        });
        $("#ddlOperacion").change(function (e, data) {
            cargarComboProducto();
        });

        $("#btnExportar").click(function () {
            return;
        });

        var url = '@Url.Action("JSON_GetDashboard03", "REP")';
        $('#btnReporte').click(function () {
            //$("#overlay").show();
            $("#pControl").hide();
            var fechaDesde = $('#txtFecDesde').val();
            var fechaHasta = $('#txtFecHasta').val();
            var codMoneda = $('#ddlMoneda option:selected').val();
            var codPersoneria = $('#ddlPersoneria option:selected').val();
            var codTipCliente = $('#ddlTipCliente option:selected').val();
            var codOperacion = $('#ddlOperacion option:selected').val();
            var codProducto = $('#ddlProducto option:selected').val();
            var codClasificacionInterna = $('#ddlClasificacion option:selected').val();
            var garantia = $('#ddlGarantia option:selected').val();
            var codAgencia = $('#ddlAgencia option:selected').val();
            var codFuncionario = $('#ddlFuncionario option:selected').val();

            var _obj = {
                fechaDesde: fechaDesde,
                fechaHasta: fechaHasta,
                codMoneda: codMoneda,
                codPersoneria: codPersoneria,
                codTipCliente: codTipCliente,
                codOperacion: codOperacion,
                codProducto: codProducto,
                codClasificacionInterna: codClasificacionInterna,
                garantia: garantia,
                codAgencia: codAgencia,
                codFuncionario: codFuncionario,
            }
            console.log(_obj);
            $.ajax({
                url: url,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(_obj),
                success: function (response) {
                    console.log(response);
                    /*
                    $('#reportView').html(response); // asumiendo que el servidor devuelve HTML
                    setTimeout(function () {
                        $('iframe').contents().find('body').css('backgroundColor', '#ffffff');
                        $("#overlay").hide();
                    }, 8000);
                    */
                    construirDashboard(response);
                    //$("#overlay").hide();
                }
            });

        });

        function construirDashboard(res) {

            var data0 = res.filter(x => x.item == 0);
            var categoria = data0.map(x => x.categoria);
            var color = data0.map(x => x.color);
            var no = data0.map(x => x.no);
            var profit = data0.map(x => x.profit);
            var rorac = data0.map(x => x.rorac);

            construirChartPie('chart01', "Distribucion WIN/LOSS", categoria, no, color);
            construirChartBarVer('chart02', "Análisis de Rentabilidad Esperada", categoria, "Profit", "RORAC", profit, rorac);

            var data3 = res.filter(x => x.item == 3);

            var categorias = [];
            data3.forEach(item => {
                if (!categorias.some(c => c.nombre === item.categoria)) {
                    categorias.push({ nombre: item.categoria, codCat: item.codCat });
                }
            });
            var rubros = [...new Set(data3.map(item => item.rubro))];
            var datasets = categorias.map(categoria => {
                return {
                    label: categoria.nombre,
                    data: rubros.map(rubro => {
                        const entry = data3.find(d => d.rubro === rubro && d.categoria === categoria.nombre);
                        return entry ? parseFloat((entry.ratio * 100).toFixed(1)) : 0;
                    }),
                    backgroundColor: getColor(categoria.codCat),
                    datalabels: {
                        color: '#fff', // blanco fijo
                        anchor: 'center',
                        align: 'center',
                        formatter: v => (v && v > 0) ? v + '%' : null // null oculta etiquetas con valor 0 o null
                    }
                };
            });

            construirChart03('chart03', "Distribución WIN/LOSS por Producto", rubros, datasets);

            var data1 = res.filter(x => x.item == 0);
            var categoria1 = data1.map(x => x.categoria);
            no = data1.map(x => x.no);

            construirChartPie('chart04', "No tomadas por el Banco", categoria1, no, color);

            var spread = data0.map(x => x.spread);
            var tea = data0.map(x => x.tea);
            construirChartBarVer('chart05', "Análisis de Margen", categoria, "Spread", "Tasa", spread, tea);


            var data4 = res.filter(x => x.item == 4);
            var categorias = [];
            data4.forEach(item => {
                if (!categorias.some(c => c.nombre === item.categoria)) {
                    categorias.push({ nombre: item.categoria, codCat: item.codCat });
                }
            });
            var rubros = [...new Set(data4.map(item => item.rubro))];
            var datasets = categorias.map(categoria => {
                return {
                    label: categoria.nombre,
                    data: rubros.map(rubro => {
                        const entry = data4.find(d => d.rubro === rubro && d.categoria === categoria.nombre);
                        return entry ? parseFloat((entry.ratio * 100).toFixed(1)) : 0;
                    }),
                    backgroundColor: getColor(categoria.codCat),
                    datalabels: {
                        color: '#fff', // blanco fijo
                        anchor: 'center',
                        align: 'center',
                        formatter: v => (v && v > 0) ? v + '%' : null // null oculta etiquetas con valor 0 o null
                    }
                };
            });
            construirChart03('chart06', "Distribución WIN/LOSS por Tipo Cliente", rubros, datasets);

            var data2 = res.filter(x => x.item == 2);
            var categoria2 = data2.map(x => x.categoria);
            var no = data2.map(x => x.no);
            construirChartBarHor('chart07', "Ganadas por la Competencia", categoria2, no)

            var esperada = data0.map(x => x.esperada);
            construirChartBarVer('chart08', "Análisis de Rorac vs Pérdida Esperada", categoria, "Pérdida Esperada", "RORAC", esperada, rorac);

            var data5 = res.filter(x => x.item == 5);
            var categorias = [];
            data5.forEach(item => {
                if (!categorias.some(c => c.nombre === item.categoria)) {
                    categorias.push({ nombre: item.categoria, codCat: item.codCat });
                }
            });
            var rubros = [...new Set(data5.map(item => item.rubro))];
            var datasets = categorias.map(categoria => {
                return {
                    label: categoria.nombre,
                    data: rubros.map(rubro => {
                        const entry = data5.find(d => d.rubro === rubro && d.categoria === categoria.nombre);
                        return entry ? parseFloat((entry.ratio * 100).toFixed(1)) : 0;
                    }),
                    backgroundColor: getColor(categoria.codCat),
                    datalabels: {
                        color: '#fff', // blanco fijo
                        anchor: 'center',
                        align: 'center',
                        formatter: v => (v && v > 0) ? v + '%' : null // null oculta etiquetas con valor 0 o null
                    }
                };
            });
            construirChart03('chart09', "Distribución WIN/LOSS por Funcionario", rubros, datasets);
        }
        function getColor(codCat) {
            if (codCat === "1") return '#8c1b1b';
            if (codCat === "2") return '#bcb88a';
            return '#444'; // cod_cat 3 u otros
        }
        function construirChartPie(chartId, titulo, label, importe, color){
            const ctx = document.getElementById(chartId).getContext('2d');
            // Destruir el chart anterior si ya existe
            if (charts[chartId]) {
                charts[chartId].destroy();
            }
            charts[chartId] = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: label,
                    datasets: [{
                        data: importe,
                        backgroundColor: color,
                        borderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: titulo,
                            font: {
                                size: 18,
                                weight: 'bold'
                            },
                            padding: {
                                top: 10,
                                bottom: 20
                            },
                            color: '#000'
                        },
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#000',
                                font: {
                                    size: 12
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    //return `${context.label}: ${context.raw.toFixed(2)}%`;
                                    const value = context.raw;
                                    const data = context.dataset.data;
                                    const total = data.reduce((acc, val) => acc + val, 0);
                                    const percentage = ((value / total) * 100).toFixed(2);
                                    return `${context.label}: ${value} (${percentage}%)`;
                                }
                            }
                        },
                        datalabels: {
                            //formatter: (value) => value.toFixed(2) + '%',
                            //color: '#fff'
                            formatter: (value, context) => {
                                const data = context.chart.data.datasets[0].data;
                                const total = data.reduce((acc, val) => acc + val, 0);
                                const percentage = (value / total * 100).toFixed(2);
                                return `${percentage}%`;
                            },
                            color: '#fff'
                        }
                    }
                },
                plugins: [ChartDataLabels] // Si usas data labels
            });
        }
        function construirChartBarHor(chartId, titulo, label, importe) {
            const ctx = document.getElementById(chartId).getContext('2d');
            // Destruir el chart anterior si ya existe
            if (charts[chartId]) {
                charts[chartId].destroy();
            }
            charts[chartId] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: label,
                    datasets: [{
                        data: importe,
                        backgroundColor: ['#4A4A4A', '#8C8A6E', '#D3C48D', '#B23A36', '#C0C0C0', '#1E2330'],
                        barThickness: 24
                    }]
                },
                options: {
                    indexAxis: 'y',
                    plugins: {
                        legend: { display: false },
                        title: {
                            display: true,
                            text: 'Ganadas por la Competencia',
                            font: { size: 18 }
                        },
                        datalabels: {
                            anchor: 'end',
                            align: 'right',
                            formatter: v => v,
                            font: { weight: 'bold' },
                            color: '#000'
                        }
                    },
                    scales: {
                        x: {
                            display: false,
                            beginAtZero: true,
                            ticks: { stepSize: 1 }
                        },
                        y: {
                            grid: { display: false }
                        }
                    },
                    layout: {
                        padding: { top: 10, right: 20, bottom: 10, left: 10 }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }
        function construirChartBarVer(chartId, titulo, label, etiqueta1, etiqueta2, importe1, importe2) {
            const ctx = document.getElementById(chartId).getContext('2d');
            // Destruir el chart anterior si ya existe
            if (charts[chartId]) {
                charts[chartId].destroy();
            }
            charts[chartId] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: label,
                    datasets: [
                        {
                            label: etiqueta1,
                            data: importe1,
                            backgroundColor: chartId == "chart05" ? '#55585a' : '#444',
                            datalabels: {
                                anchor: 'end',
                                align: 'end',
                                offset: -4,
                                color: '#000',
                                formatter: (value) => {
                                    return (typeof value === 'number' && !isNaN(value)) ? (value * 100).toFixed(2) + '%' : '';
                                }
                            }
                        },
                        {
                            label: etiqueta2,
                            data: importe2,
                            backgroundColor: chartId == "chart05" ? '#929172' : '#8c1b1b',
                            datalabels: {
                                anchor: 'end',
                                align: 'end',
                                offset: -4,
                                color: '#000',
                                formatter: (value) => {
                                    return (typeof value === 'number' && !isNaN(value)) ? (value * 100).toFixed(2) + '%' : '';
                                }
                            }
                        }
                    ]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: titulo,
                            font: {
                                size: 18,
                                weight: 'bold'
                            },
                            padding: {
                                top: 10,
                                bottom: 20
                            },
                            color: '#000'
                        },
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#000',
                                font: {
                                    size: 12
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return `${context.dataset.label}: ${(context.raw * 100).toFixed(2)}%`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            display: false,
                            beginAtZero: true,
                            grid: {
                                display: false // ❌ sin grilla Y
                            },
                            ticks: {
                                callback: function (value) {
                                    return value + '%';
                                }
                            }
                        },
                        x: {
                            ticks: {
                                font: {
                                    size: 11 // o incluso 9
                                }
                            },
                            grid: {
                                display: false // ❌ sin grilla X
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        }
        function construirChart03(chartId, titulo, label, dataset) {

            const ctx = document.getElementById(chartId).getContext('2d');
            // Destruir el chart anterior si ya existe
            if (charts[chartId]) {
                charts[chartId].destroy();
            }
            charts[chartId] = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: label,
                    datasets: dataset,
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: titulo,
                            font: {
                                size: 18,
                                weight: 'bold'
                            },
                            padding: {
                                top: 10,
                                bottom: 20
                            },
                            color: '#000'
                        },
                        legend: {
                            position: 'bottom'
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    return `${context.dataset.label}: ${context.raw}%`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            stacked: true,
                            beginAtZero: true,
                            max: 100,
                            grid: {
                                display: false
                            },
                            ticks: {
                                callback: v => v + '%'
                            }
                        },
                        y: {
                            stacked: true,
                            grid: {
                                display: false
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });

        }

        $('#btnControles').click(function () {
            if ($("#pControl").is(":visible") == true) {
                $("#pControl").hide();
            } else {
                $("#pControl").show();
            }

        });


});

    </script>
}
