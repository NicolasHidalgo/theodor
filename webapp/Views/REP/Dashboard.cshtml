@*@using ReportViewerForMvc*@
@model webapp.ViewModels.AuxiliarEdit
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Theme JS files -->

<script type="text/javascript" src="~/assets/js/core/app.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/validation/validate.min.js"></script>
<script type="text/javascript" src="~/assets/js/core/libraries/jquery_ui/interactions.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/tables/datatables/datatables.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/selects/select2.min.js"></script>
<script type="text/javascript" src="~/assets/js/pages/form_select2.js"></script>

@*<script type="text/javascript" src="~/assets/js/pages/components_modals.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/styling/uniform.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/selects/bootstrap_multiselect.js"></script>
<script type="text/javascript" src="~/assets/js/pages/form_multiselect.js"></script>*@

@*<script type="text/javascript" src="~/Scripts/jquery.stickytableheaders.min.js"></script>*@
<!-- /theme JS files -->

<style>
    .tblTitle {
        text-align: center;
        color: dimgray;
        font-weight: 600;
    }
    .tblHeader {
        text-align: center;
        color: dimgray;
        font-weight: 600;
    }
    #tblDashboard th {
        height: 15px;
        line-height: 15px;
        padding: 5px;
    }
    #tblDashboard td {
        height: 2px; /* Altura de fila fija */
        /*padding: 0; Elimina relleno interno que aumente la altura */
        line-height: 2px; /* Alinea verticalmente el texto en una sola línea */
        overflow: hidden; /* Evita que el contenido se desborde */
        white-space: nowrap; /* Evita saltos de línea */
        vertical-align: middle; /* Centra verticalmente el contenido */
        box-sizing: border-box; /* Asegura que padding no sume al alto */
    }
    
</style>

<!-- Main content -->
<div class="container-fluid">
    <!-- Page header -->
    <div class="page-header">
        <div class="page-header-content">
        </div>
        <div class="breadcrumb-line breadcrumb-line-component">
            <ul class="breadcrumb">
                <li><a href="@Url.Action("Index","Home")"><i class="icon-printer position-left"></i> Tablero de Control</a></li>
            </ul>
            <ul class="breadcrumb-elements">
                <li><a id="btnControles"><i class="icon-cogs" title="Controles"></i></a></li>
                <li><a id="btnExportar"><i class="icon-file-excel" title="Exportar Excel"></i></a></li>
                <li><a id="btnReporte"><i class="icon-printer2" title="Reporte"></i></a></li>
                @*<li><a id="btnCerrar"><i class="icon-lock" title="Cierre"></i></a></li>*@

            </ul>
        </div>
    </div>
    <!-- /page header -->
    <!-- Content area -->
    <div class="content">
        <!-- Page length options -->
        <div id="pControl" class="panel panel-flat">

            <div class="panel-body">
                <div class="col-md-12">

                    <div class="form-group col-md-2">
                        <label>Fec Desde:</label>
                        <input id="txtFecDesde" type="month" class="form-control" />
                    </div>
                    <div class="form-group col-md-2">
                        <label>Fec Hasta:</label>
                        <input id="txtFecHasta" type="month" class="form-control" />
                    </div>

                    <div class="form-group col-md-2">
                        <label>Moneda:</label>
                        <select id="ddlMoneda" name="ddlMoneda" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlMoneda)
                            {
                                @*<option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Text</option>*@
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Personeria:</label>
                        <select id="ddlPersoneria" name="ddlPersoneria" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlPersoneria)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Tipo Cliente:</label>
                        <select id="ddlTipCliente" name="ddlTipCliente" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlTipCliente)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Operacion:</label>
                        <select id="ddlOperacion" name="ddlOperacion" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlOperacion)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Producto:</label>
                        <select id="ddlProducto" name="ddlProducto" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlProducto)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Clasificación:</label>
                        <select id="ddlClasificacion" name="ddlClasificacion" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlClasificacionInterna)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Garantia:</label>
                        <select id="ddlGarantia" name="ddlGarantia" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlGarantiaPersonal)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group col-md-2">
                        <label>Agencia:</label>
                        <select id="ddlAgencia" name="ddlAgencia" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlAgencia)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="form-group col-md-2">
                        <label>Funcionario:</label>
                        <select id="ddlFuncionario" name="ddlFuncionario" class="select">
                            <option value="" selected>--TODOS--</option>
                            @foreach (var item in Model.ddlFuncionario)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>



                </div>
            </div>
        </div>
        <!-- /page length options -->
        <div class="panel panel-flat">
            <div id="reportView" class="img-fluid">
                <div class="table-responsive">
                    <table id="tblDashboard" class="table table-bordered" style="width: 100%; table-layout: fixed; border-collapse: collapse; font-size: 9.5px; ">
                        <colgroup>
                            <col style="width: 9%;"> <!-- nomRef -->
                            <col style="width: 3%;">  <!-- noEnProceso -->
                            <col style="width: 5%;">  <!-- montoEnProceso -->
                            <col style="width: 3%;">  <!-- noDesembolsado -->
                            <col style="width: 5%;">  <!-- desembolso -->
                            <col style="width: 5%;">  <!-- tea -->
                            <col style="width: 5%;">  <!-- perdidaEsperada -->
                            <col style="width: 4%;">  <!-- spread -->
                            <col style="width: 4%;">  <!-- profit -->
                            <col style="width: 4%;">  <!-- RORAC -->
                            <col style="width: 5%;">  <!-- utilidad -->
                            <col style="width: 5%;">  <!-- desembolsoObjetivo -->
                            <col style="width: 4%;">  <!-- teaObjetivo -->
                            <col style="width: 5%;">  <!-- RORACObjetivo -->
                            <col style="width: 5%;">  <!-- Ranking RORAC -->
                            <col style="width: 5%;">  <!-- Ranking Desembolso -->
                        </colgroup>
                        <thead>
                            <tr>
                                <th></th>
                                <th colspan="2" class="tblTitle">Ope. En Proceso</th>
                                <th colspan="8" class="tblTitle">Operaciones Desembolsadas</th>
                                <th colspan="3" class="tblTitle">Objetivos</th>
                                <th colspan="2" class="tblTitle">Ranking</th>
                            </tr>
                            <tr>
                                <th class="tblHeader"></th>
                                <th class="tblHeader">No.</th>
                                <th class="tblHeader">Monto</th>
                                <th class="tblHeader">No.</th>
                                <th class="tblHeader">Desembol</th>
                                <th class="tblHeader">Tasa Operación</th>
                                <th class="tblHeader">Perdida Esperada</th>
                                <th class="tblHeader">Spread</th>
                                <th class="tblHeader">Profit</th>
                                <th class="tblHeader">RORAC</th>
                                <th class="tblHeader">Utilidad</th>
                                <th class="tblHeader">Desembol</th>
                                <th class="tblHeader">Tasa</th>
                                <th class="tblHeader">RORAC</th>
                                <th class="tblHeader">Ranking RORAC</th>
                                <th class="tblHeader">Ranking Desembol</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                
            </div>
            
        </div>
        
    </div>
    <!-- /content area -->
</div>
<!-- /main content -->


@section Scripts {
    <script type="text/javascript">

    var arrTipCliente = [];
    var arrProducto = [];

    $(document).ready(function () {

        var jsModel = @Html.Raw(Json.Encode(Model));
        arrTipCliente = jsModel.ddlTipCliente;
        arrProducto = jsModel.ddlProducto;

        function cargarComboTipCliente() {
            var _codParam = $("#ddlPersoneria option:selected").val();
            var _filtered = arrTipCliente.filter(x => x.Aux2 == _codParam);
            $('#ddlTipCliente').empty();
            $('#ddlTipCliente').append($('<option/>', {
                value: '',
                text: '--TODOS--',
                selected: true
            }));
            $.each(_filtered, function (index, item) {
                $('#ddlTipCliente').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
            cargarComboProducto();
        }
        function cargarComboProducto() {
            var _codParam = $("#ddlOperacion option:selected").val();
            var _filtered = arrProducto.filter(x => x.Aux2 == _codParam);
            $('#ddlProducto').empty();
            $('#ddlProducto').append($('<option/>', {
                value: '',
                text: '--TODOS--',
                selected: true
            }));
            $.each(_filtered, function (index, item) {
                $('#ddlProducto').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
        }
        cargarComboTipCliente();

        $("#ddlPersoneria").change(function (e, data) {
            cargarComboTipCliente();
        });
        $("#ddlOperacion").change(function (e, data) {
            cargarComboProducto();
        });

        $("#btnExportar").click(function () {
            return;
            $("#overlay").show();
            var codUnidadNegocio = $('#ddlUnidad').val();
            var codFrecuencia = $('#ddlFrecuencia').val();
            var codCargaAuxiliar = $('#ddlFormato').val();
            var codRangoFecha = $('#ddlFecha option:selected').val();
            var _url = '@Url.Action("RunXls", "KOP")?idx=@Session.SessionID&cod_unidad_negocio=' + codUnidadNegocio + '&cod_frecuencia=' + codFrecuencia + '&cod_rango_fecha=' + codRangoFecha +'&cod_carga_auxiliar='+codCargaAuxiliar;

            $.post(_url, null).done(function (data) {
                $("#overlay").hide();
                if (data.Status === 200) {
                    window.location.href = '@Url.Content("~")'+'KOP/DownloadFile?archivoDestino='+ data.Message+ '&idx=@Session.SessionID';
                }
                else {
                    toastr.error(data.Message)
                }
            });
        });

        var url = '@Url.Action("JSON_GetDashboard01", "REP")';
        $('#btnReporte').click(function () {
            $("#overlay").show();
            $("#pControl").hide();
            var fechaDesde = $('#txtFecDesde').val();
            var fechaHasta = $('#txtFecHasta').val();
            var codMoneda = $('#ddlMoneda option:selected').val();
            var codPersoneria = $('#ddlPersoneria option:selected').val();
            var codTipCliente = $('#ddlTipCliente option:selected').val();
            var codOperacion = $('#ddlOperacion option:selected').val();
            var codProducto = $('#ddlProducto option:selected').val();
            var codClasificacionInterna = $('#ddlClasificacion option:selected').val();
            var garantia = $('#ddlGarantia option:selected').val();
            var codAgencia = $('#ddlAgencia option:selected').val();
            var codFuncionario = $('#ddlFuncionario option:selected').val();

            var _obj = {
                fechaDesde: fechaDesde,
                fechaHasta: fechaHasta,
                codMoneda: codMoneda,
                codPersoneria: codPersoneria,
                codTipCliente: codTipCliente,
                codOperacion: codOperacion,
                codProducto: codProducto,
                codClasificacionInterna: codClasificacionInterna,
                garantia: garantia,
                codAgencia: codAgencia,
                codFuncionario: codFuncionario,
            }

            $.ajax({
                url: url,
                type: "GET",
                contentType: "application/json",
                data: JSON.stringify(_obj),
                success: function (response) {
                    console.log(response);
                    /*
                    $('#reportView').html(response); // asumiendo que el servidor devuelve HTML
                    setTimeout(function () {
                        $('iframe').contents().find('body').css('backgroundColor', '#ffffff');
                        $("#overlay").hide();
                    }, 8000);
                    */
                    construirDashboard(response);
                    $("#overlay").hide();
                }
            });

        });

        function construirDashboard(response) {
            const tbody = $("#tblDashboard tbody");
            tbody.empty(); // Limpia cualquier contenido previo

            // Si necesitas mostrar un grupo (como "Vista Personería"), agrúpalo aquí
            

            var c = 0;
            var lastRubro = "";
            response.forEach(item => {
                if (c == 0 || lastRubro != item.rubro) {
                    lastRubro = item.rubro;
                    tbody.append(`
                        <tr style="background-color:black;color:white;">
                            <td align='left' colspan="16">${item.rubro}</td>
                        </tr>
                    `);
                }
                const row = `
            <tr>
                <td align='left'>${item.nomRef}</td>
                <td align='right'>${item.noEnProceso}</td>
                <td align='right'>${numeral(item.montoEnProceso).format('#,##0')}</td>
                <td align='right'>${item.noDesembolsado}</td>
                <td align='right'>${numeral(item.desembolso).format('#,##0')}</td>
                <td align='right'>${numeral(item.tea).format('0.00%')}</td>
                <td align='right'>${numeral(item.perdidaEsperada).format('0.00%')}</td>
                <td align='right'>${numeral(item.spread).format('0.00%')}</td>
                <td align='right'>${numeral(item.profit).format('0.00%')}</td>
                <td align='right'>${numeral(item.RORAC).format('0.00%')}</td>
                <td align='right'>${numeral(item.utilidad).format('#,##0')}</td>
                <td align='right'>${numeral(item.desembolsoObjetivo).format('#,##0')}</td>
                <td align='right'>${numeral(item.teaObjetivo).format('0.00%')}</td>
                <td align='right'>${numeral(item.RORACObjetivo).format('0.00%')}</td>
                <td align='right'>${numeral(item.RORACObjetivo).format('0.00%')} <img src="../assets/images/verde.png" /></td>
                <td align='right'>${numeral(item.RORACObjetivo).format('0.00%')} <img src="../assets/images/verde.png" /></td>
            </tr>
        `;
                c++;
                tbody.append(row);
            });
        }

        $('#btnControles').click(function () {
            if ($("#pControl").is(":visible") == true) {
                $("#pControl").hide();
            } else {
                $("#pControl").show();
            }

        });


});

    </script>
}
