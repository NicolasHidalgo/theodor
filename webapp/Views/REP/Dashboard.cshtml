        function getColor(codCat) {
            if (codCat === "1") return '#8c1b1b';
            if (codCat === "2") return '#bcb88a';
            return '#444'; // cod_cat 3 u otros
        }
        function construirChartAPie(chartId, titulo, label, importe, color) {
            const ctx = document.getElementById(chartId).getContext('2d');
            // Destruir el chart anterior si ya existe
            if (charts[chartId]) {
                charts[chartId].destroy();
            }
            charts[chartId] = new Chart(ctx, {
                type: 'pie',
                data: {
                    labels: label,
                    datasets: [{
                        data: importe,
                        backgroundColor: color,
                        borderColor: '#fff',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        title: {
                            display: true,
                            text: titulo,
                            font: {
                                size: 18,
                                weight: 'bold'
                            },
                            padding: {
                                top: 10,
                                bottom: 20
                            },
                            color: '#000'
                        },
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#000',
                                font: {
                                    size: 12
                                }
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (context) {
                                    //return `${context.label}: ${context.raw.toFixed(2)}%`;
                                    const value = context.raw;
                                    const data = context.dataset.data;
                                    const total = data.reduce((acc, val) => acc + val, 0);
                                    const percentage = ((value / total) * 100).toFixed(2);
                                    return `${context.label}: ${value} (${percentage}%)`;
                                }
                            }
                        },
                        datalabels: {
                            //formatter: (value) => value.toFixed(2) + '%',
                            //color: '#fff'
                            formatter: (value, context) => {
                                const data = context.chart.data.datasets[0].data;
                                const total = data.reduce((acc, val) => acc + val, 0);
                                const percentage = (value / total * 100).toFixed(2);
                                return `${percentage}%`;
                            },
                            color: '#fff'
                        }
                    }
                },
                plugins: [ChartDataLabels] // Si usas data labels
            });
        }
