@section Scripts {
    <script type="text/javascript">

    var arrTipCliente = [];
    var arrProducto = [];
    const charts = {};

    $(document).ready(function () {

        $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            btnReporteClick();
        });
        function tabDashboard(res) {
            var hrefActivo = $(".nav-tabs li.active a").attr("href");

            if (hrefActivo === "#tab1") {
                construirDashboard01(res);
            } else if (hrefActivo === "#tab2") {
                construirDashboard02(res);
            } else if (hrefActivo === "#tab3") {
                construirDashboard03(res);
            }
        }

        var jsModel = @Html.Raw(Json.Encode(Model));
        arrTipCliente = jsModel.ddlTipCliente;
        arrProducto = jsModel.ddlProducto;

        function cargarComboTipCliente() {
            var _codParam = $("#ddlPersoneria option:selected").val();
            var _filtered = arrTipCliente.filter(x => x.Aux2 == _codParam);
            $('#ddlTipCliente').empty();
            $('#ddlTipCliente').append($('<option/>', {
                value: '',
                text: '--TODOS--',
                selected: true
            }));
            $.each(_filtered, function (index, item) {
                $('#ddlTipCliente').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
            cargarComboProducto();
        }
        function cargarComboProducto() {
            var _codParam = $("#ddlOperacion option:selected").val();
            var _filtered = arrProducto.filter(x => x.Aux2 == _codParam);
            $('#ddlProducto').empty();
            $('#ddlProducto').append($('<option/>', {
                value: '',
                text: '--TODOS--',
                selected: true
            }));
            $.each(_filtered, function (index, item) {
                $('#ddlProducto').append($('<option/>', {
                    value: item.Value,
                    text: item.Text,
                    selected: false //item.Selected
                }));
            });
        }
        cargarComboTipCliente();

        $("#ddlPersoneria").change(function (e, data) {
            cargarComboTipCliente();
        });
        $("#ddlOperacion").change(function (e, data) {
            cargarComboProducto();
        });

        $("#btnExportar").click(function () {
            return;
            $("#overlay").show();
            var codUnidadNegocio = $('#ddlUnidad').val();
            var codFrecuencia = $('#ddlFrecuencia').val();
            var codCargaAuxiliar = $('#ddlFormato').val();
            var codRangoFecha = $('#ddlFecha option:selected').val();
            var _url = '@Url.Action("RunXls", "KOP")?idx=@Session.SessionID&cod_unidad_negocio=' + codUnidadNegocio + '&cod_frecuencia=' + codFrecuencia + '&cod_rango_fecha=' + codRangoFecha +'&cod_carga_auxiliar='+codCargaAuxiliar;

            $.post(_url, null).done(function (data) {
                $("#overlay").hide();
                if (data.Status === 200) {
                    window.location.href = '@Url.Content("~")'+'KOP/DownloadFile?archivoDestino='+ data.Message+ '&idx=@Session.SessionID';
                }
                else {
                    toastr.error(data.Message)
                }
            });
        });

        $('#btnReporte').click(function () {
            btnReporteClick();
        });

        function btnReporteClick() {
            $("#overlay").show();
            $("#pControl").hide();

            var url = "";
            var hrefActivo = $(".nav-tabs li.active a").attr("href");
            if (hrefActivo === "#tab1") {
                url = '@Url.Action("JSON_GetDashboard01", "REP")';
            } else if (hrefActivo === "#tab2") {
                url = '@Url.Action("JSON_GetDashboard02", "REP")';
            } else if (hrefActivo === "#tab3") {
                url = '@Url.Action("JSON_GetDashboard03", "REP")';
            }

            var fechaDesde = $('#txtFecDesde').val();
            var fechaHasta = $('#txtFecHasta').val();
            var codMoneda = $('#ddlMoneda option:selected').val();
            var codPersoneria = $('#ddlPersoneria option:selected').val();
            var codTipCliente = $('#ddlTipCliente option:selected').val();
            var codOperacion = $('#ddlOperacion option:selected').val();
            var codProducto = $('#ddlProducto option:selected').val();
            var codClasificacionInterna = $('#ddlClasificacion option:selected').val();
            var garantia = $('#ddlGarantia option:selected').val();
            var codAgencia = $('#ddlAgencia option:selected').val();
            var codFuncionario = $('#ddlFuncionario option:selected').val();

            var _obj = {
                fechaDesde: fechaDesde,
                fechaHasta: fechaHasta,
                codMoneda: codMoneda,
                codPersoneria: codPersoneria,
                codTipCliente: codTipCliente,
                codOperacion: codOperacion,
                codProducto: codProducto,
                codClasificacionInterna: codClasificacionInterna,
                garantia: garantia,
                codAgencia: codAgencia,
                codFuncionario: codFuncionario,
            }
            console.log(_obj);
            $.ajax({
                url: url,
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(_obj),
                success: function (response) {
                    console.log(response);
                    /*
                    $('#reportView').html(response); // asumiendo que el servidor devuelve HTML
                    setTimeout(function () {
                        $('iframe').contents().find('body').css('backgroundColor', '#ffffff');
                        $("#overlay").hide();
                    }, 8000);
                    */
                    tabDashboard(response);
                    $("#overlay").hide();
                }
            });
        }

        function construirDashboard01(response) {
            const tbody = $("#tblDashboard tbody");
            tbody.empty(); // Limpia cualquier contenido previo

            // Si necesitas mostrar un grupo (como "Vista Personería"), agrúpalo aquí


            var c = 0;
            var lastRubro = "";
            response.forEach(item => {
                if ((c == 0 || lastRubro != item.rubro) && response.length != c + 1) {
                    lastRubro = item.rubro;
                    tbody.append(`
                        <tr style="background-color:black;color:white;font-size:14px;">
                            <td align='left' colspan="16" style="padding-left:10px;">${item.rubro}</td>
                        </tr>
                    `);
                }

                var style = 'font-size:12px;';
                var nomRef = item.nomRef;
                if (item.rubro.includes('Total')) {
                    style = 'font-size:13px;font-weight: bold;'
                    nomRef = item.rubro;
                }
                const row = `
            <tr style='${style}'>
                <td align='left' style="padding-left:10px;padding-top: 0px;padding-bottom: 0px;">${nomRef}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${item.noEnProceso}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.montoEnProceso).format('#,##0')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${item.noDesembolsado}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.desembolso).format('#,##0')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.tea).format('0.00%')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.perdidaEsperada).format('0.00%')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.spread).format('0.00%')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.profit).format('0.00%')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.rorac).format('0.00%')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.utilidad).format('#,##0')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.desembolsoObjetivo).format('#,##0')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.teaObjetivo).format('0.00%')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.roracObjetivo).format('0.00%')}</td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.rankingRorac).format('0.00%')} <img src="../assets/images/${item.rankingcRorac}.png" /></td>
                <td align='right' style="padding-top: 2px;padding-bottom: 2px;">${numeral(item.rankingDesembolso).format('0.00%')} <img src="../assets/images/${item.rankingcDesembolso}.png" /></td>
            </tr>
        `;
                c++;
                tbody.append(row);
            });
        }

        function construirDashboard02(res) {

            var eTotal = res.filter(x => x.item == 1);
            var eMN = res.filter(x => x.item == 2);
            var eME = res.filter(x => x.item == 3);

            var eTotalFecha = eTotal.map(x => { return moment(x.fecha).format('MMM/YYYY'); });
            var eTotalTea = eTotal.map(x => x.tea);
            var eTotalRorac = eTotal.map(x => x.rorac);
            var eTotalDesembolsado = eTotal.map(x => x.desembolsado);
            var eTotalUtilidad = eTotal.map(x => x.utilidad);
            var eTotalProfit = eTotal.map(x => x.profit);

            var eMNFecha = eMN.map(x => { return moment(x.fecha).format('MMM/YYYY'); });
            var eMNTea = eMN.map(x => x.tea);
            var eMNRorac = eMN.map(x => x.rorac);
            var eMNDesembolsado = eMN.map(x => x.desembolsado);
            var eMNUtilidad = eMN.map(x => x.utilidad);
            var eMNProfit = eMN.map(x => x.profit);

            var eMEFecha = eME.map(x => { return moment(x.fecha).format('MMM/YYYY'); });
            var eMETea = eME.map(x => x.tea);
            var eMERorac = eME.map(x => x.rorac);
            var eMEDesembolsado = eME.map(x => x.desembolsado);
            var eMEUtilidad = eME.map(x => x.utilidad);
            var eMEProfit = eME.map(x => x.profit);

            construirChartEFila01('chartE01', "", eTotalFecha, eTotalTea, eTotalRorac);
            construirChartEFila01('chartE02', "MN", eMNFecha, eMNTea, eMNRorac);
            construirChartEFila01('chartE03', "ME", eMEFecha, eMETea, eMERorac);

            construirChartEFila02('chartE04', "", eTotalFecha, eTotalDesembolsado, "#22283f");
            construirChartEFila02('chartE05', "MN", eMNFecha, eMNDesembolsado, "#a5343a");
            construirChartEFila02('chartE06', "ME", eMEFecha, eMEDesembolsado, "#7b7356");

