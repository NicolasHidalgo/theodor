@model webapp.ViewModels.AuxiliarEdit
@{
    ViewBag.Title = "Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!-- Theme JS files -->
<script type="text/javascript" src="~/assets/js/plugins/tables/datatables/datatables.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/selects/select2.min.js"></script>
<script type="text/javascript" src="~/assets/js/core/app.js"></script>
<script type="text/javascript" src="~/assets/js/pages/datatables_advanced.js"></script>
<script type="text/javascript" src="~/assets/js/pages/components_modals.js"></script>

<script type="text/javascript" src="~/assets/js/plugins/forms/validation/validate.min.js"></script>
<script type="text/javascript" src="~/assets/js/core/libraries/jquery_ui/interactions.min.js"></script>
<script type="text/javascript" src="~/assets/js/pages/form_select2.js"></script>

<script type="text/javascript" src="~/assets/js/plugins/forms/styling/uniform.min.js"></script>
<script type="text/javascript" src="~/assets/js/plugins/forms/selects/bootstrap_multiselect.js"></script>
<script type="text/javascript" src="~/assets/js/pages/form_multiselect.js"></script>

<script type="text/javascript" src="~/assets/otros/stickytableheaders/jquery.stickytableheaders.min.js"></script>

<!-- /theme JS files -->
<!-- modal buscador -->
<div id="BuscarModal" class="modal fade" role="dialog" aria-labelledby="BuscarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-body">
                <h6 class="modal-title text-semibold">Buscar</h6>
                <div class="form-group">
                    <input class="form-control " id="txtFiltro" placeholder="Buscar...">
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /modal buscador -->
<!-- modal de confirmacion -->
<div id="ConfirmarModal" class="modal fade" role="dialog" aria-labelledby="ConfirmarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-body">
                <h6 class="modal-title text-semibold">Confirmar</h6>
                <p>Está seguro de que desea eliminar este registro?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-link" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnEliminar">Eliminar</button>
            </div>
        </div>
    </div>
</div>
<!-- /modal de confirmacion -->

<div id="editModal" class="modal fade" role="dialog" aria-labelledby="titulo" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titulo">Nuevo Registro</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <form id="FormPlantilla">
                <div class="modal-body">
                    <div class="form-group hide">
                        <label for="txtId" class="col-form-label">#</label>
                        <input type="text" class="form-control" id="txtId" name="txtId">
                    </div>
                    <div class="form-group">
                        <label for="txtCodUsuario" class="col-form-label">Cod. Usuario</label>
                        <input type="text" class="form-control" id="txtCodUsuario" name="txtCodUsuario">
                    </div>
                    <div class="form-group">
                        <label for="txtNomUsuario" class="col-form-label">Nombre Usuario</label>
                        <input type="text" class="form-control" id="txtNomUsuario" name="txtNomUsuario">
                    </div>
                    <div class="form-group">
                        <label for="txtCorreo" class="col-form-label">Correo</label>
                        <input type="text" class="form-control" id="txtCorreo" name="txtCorreo">
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label for="txtDiaExpClave" class="col-form-label">Dia Exp. Clave</label>
                                <input type="number" class="form-control" id="txtDiaExpClave" name="txtDiaExpClave">
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                @*<input class="form-check-input" type="checkbox" value="" id="chkEstado" name="chkEstado">
                    <label class="form-check-label" for="chkEstado">
                        Estado
                    </label>*@
                                <label>Estado</label>
                                @Html.DropDownList("ddlEstado", Model.ddlEstado, new { @class = "select" })
                            </div>
                        </div>

                    </div>


                    <div id="divResetPassword">
                        <div class="form-group">
                            <input class="form-check-input" type="checkbox" value="" id="chkResetPassword" name="chkResetPassword">
                            <label class="form-check-label" for="chkResetPassword">
                                Reset Password
                            </label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Pefil Rol</label>
                        @Html.DropDownList("ddlPerfil", Model.ddlPerfil, new { @multiple = "multiple", @class = "select" })
                    </div>


                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Aceptar</button>
                    <input type="text" id="txtOperacion" class="hide" />
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Main content -->
<div class="container-fluid">
    <!--class = "content-wrapper" hace que el width del table sea relativo-->
    <!-- Page header -->
    <div class="page-header">
        <div class="page-header-content">

        </div>
        <div class="breadcrumb-line breadcrumb-line-component">
            <ul class="breadcrumb">
                <li><i class="icon-file-empty icon-custom-style" title="Nuevo" id="btnNuevo"></i>&nbsp;<a class="botonera classNuevo">Nuevo</a></li>
                @*<li><a href="@Url.Action("Index","Home")"><i class="icon-home2 position-left"></i> Usuarios</a></li>*@
            </ul>
            <ul class="breadcrumb-elements">
                <li><a id="btnRefrescar"><i class="icon-database-refresh"></i> Refrescar</a></li>
                <li><a data-toggle="modal" data-target="#BuscarModal"><i class="icon-search4 position-left"></i> Buscar</a></li>
                @*<li><a data-toggle="modal" data-target="#editModal" data-operacion="INSERT"><i class="icon-plus3"></i> Agregar</a></li>*@
            </ul>
        </div>
    </div>
    <!-- /page header -->
    <!-- Content area -->
    <div class="content">
        <!-- Page length options -->
        <div class="panel panel-flat">
            

            <label id="CodUsuario" class="hidden">@Model.CodUsuario</label>
            <label id="CodSuscriptor" class="hidden">@Model.CodSuscriptor</label>
            <table id="UsuarioDatatable" class="table table-responsive table-bordered table-striped"></table>
        </div>
        <!-- /page length options -->
    </div>
    <!-- /content area -->
</div>
<!-- /main content -->

@section Styles{
    <style>
        .datatable-header {
            display: none;
        }

        table.dataTable thead tr {
            background-color: #3f444e;
            color: white;
        }

        .modal {
            text-align: center;
            padding: 0 !important;
        }

            .modal:before {
                content: '';
                display: inline-block;
                height: 100%;
                vertical-align: middle;
                margin-right: -4px;
            }

        .modal-dialog {
            display: inline-block;
            text-align: left;
            vertical-align: middle;
        }
    </style>
}

@section Scripts{

    <script>

    var fSelEditar;
    var fSelEliminar;

$(function () {

    var gAccion = "";
    var gCod = 0;

    fSelEditar = function (data) {
        $('#editModal').modal('show');
        $("#txtId").val(data.IDE_USUARIO);
        $("#txtCodUsuario").val(data.COD_USUARIO);
        $("#txtNomUsuario").val(data.NOM_USUARIO);
        $("#txtCorreo").val(data.CORREO_ELECTRONICO);
        $("#ddlEstado").val(data.estUsuario).change();
        $("#txtDiaExpClave").val(data.diaExpiracionClave);
        $("#divResetPassword").removeClass('hidden');

        //if (data.estUsuario == 1) {
        //    $('#chkEstado').prop('checked', true);
        //} else {
        //    $('#chkEstado').prop('checked', false);
        //}
        if (data.resetPassword == 1) {
            $('#chkResetPassword').prop('checked', true);
        } else {
            $('#chkResetPassword').prop('checked', false);
        }

        $("#ddlPerfil option").prop("selected", false);
        let valores = data.codPerfilRol.split(",");
        $.each(valores, function (index, item) {
            $("#ddlPerfil option[value='" + item + "']").prop('selected', true);
        });
        $("#ddlPerfil").trigger('change');

        $('#txtCodUsuario').prop('disabled', true);
        $("#titulo").text('Editar Registro');
        gAccion = "UPDATE";
    }
    fSelEliminar = function (cod) {
        $('#confirmBorrarModal').modal('show');
        gAccion = "DELETE";
        gCod = cod;
    }
    $("#btnNuevo,.classNuevo").on("click", function () {
        $("#titulo").text('Nuevo Registro');
        gAccion = "INSERT";
        $("#divResetPassword").addClass('hidden');
        $('#txtCodUsuario').prop('disabled', false);
        $("#txtCodUsuario, #txtNomUsuario, #txtCorreo, #txtDiaExpClave").val('');
        /*$('#chkEstado').prop('checked', true);*/
        $('#chkResetPassword').prop('checked', false);
        $("#ddlPerfil").val('').change();
        $('#editModal').modal('show');
    });

    var UsuarioDatatable = $('#UsuarioDatatable').DataTable({
        autoWidth: false,
        responsive: true,
        searching: false,
        ordering: false,
        processing: true,
        serverSide: true,
        stateSave: false,
        lengthChange: false,
        info: false,

        ajax: {
            url: urls.SEGApi.GetDataTable_Usuario(),
            type: 'GET',
            data: function (data) {
                var _filter = {
                    ACCION: 'SELECT',
                    COD_USUARIO: $("#CodUsuario").text(),
                    codSuscriptor: $("#CodSuscriptor").text(),
                    SEARCH: $('#txtFiltro').val(),
                };

                var _order = $.map(data.order, function (item) {
                    return {
                        Property: data.columns[item.column].name,
                        Direction: item.dir
                    };
                });

                delete data.columns;
                delete data.order;
                delete data.search;

                data.filter = _filter;
                data.orderby = _order;
            }
        },
        columns: [
        //{
        //    title: '#',
        //    data: 'IDE_USUARIO',
        //    width: "5%",
        //},
        {
            title: 'Usuario',
            data: 'COD_USUARIO',
            width: "15%",
        },
        {
            title: 'Nombre',
            data: 'NOM_USUARIO',
            width: "25%",
        },
        {
            title: 'Correo',
            data: 'CORREO_ELECTRONICO',
            width: "15%",
        },
        {
            title: 'Dias Exp.',
            data: 'diaExpiracionClave',
            width: "5%",
        },
        //{
        //    title: 'Fecha Vencimiento Clave',
        //    data: 'fecProximoExpiracion',
        //    width: "25%",
        //    render: function (data, type, full, meta) {
        //        if (data == null) {
        //            return "";
        //        }
        //        return moment(data).format("DD-MM-YYYY");
        //    },
        //},
        //{
        //    title: 'Fec. Creación',
        //    data: 'FEC_CREACION',
        //    width: "25%",
        //    render: function (data, type, full, meta) {
        //        if (data == null) {
        //            return "";
        //        }
        //        return moment(data).format("DD-MM-YYYY");
        //    },
        //},
        {
            title: 'Fec. Actualización',
            data: 'fecActualizacion',
            width: "15%",
            render: function (data, type, full, meta) {
                if (data == null) {
                    return "";
                }
                return moment(data).format("DD-MM-YYYY");
            },
        },
        {
            title: 'Estado',
            data: 'estado',
            width: "10%",
        },
        {
            title: 'Perfiles / Roles',
            data: 'nomPerfilRol',
            width: "25%",
        },
        {
            title: "&nbsp;",
            //orderable: false,
            width: "5%",
            render: function (data, type, full, meta) {
                //var _full = JSON.stringify(full);

                var dropdown = '<ul class="icons-list"><li class="dropdown"><a href="#" class="dropdown-toggle" data-toggle="dropdown"><i class="icon-menu9"></i></a>';
                dropdown += '<ul class="dropdown-menu dropdown-menu-right">'
                //dropdown += '<li><a data-toggle="modal" data-target="#editModal" data-row='+ meta.row +' data-operacion="UPDATE"><i class="icon-pencil4"></i> Editar</a></li>';
                //dropdown += '<li><a data-toggle="modal" data-target="#ConfirmarModal" data-row=' + meta.row +' data-operacion="DELETE"><i class="icon-bin"></i> Eliminar</a></li>';
                dropdown += "<li><a onclick='fSelEditar(" + JSON.stringify(full) + ")'><i class='icon-pencil4'></i> Editar</a></li>";
                dropdown += "<li><a onclick='fSelEliminar(" + JSON.stringify(full.ide_usuario) + ")'><i class='icon-bin'></i> Eliminar</a></li>";
                dropdown += '</ul></li></ul>';
                return dropdown;
            },
            responsivePriority: 0
        },
        ],

    });

    $('#btnRefrescar').on('click', function () {
        $("#txtFiltro").val('');
        UsuarioDatatable.draw();
    });
    $('#txtFiltro').on('keyup click', function () {
        UsuarioDatatable.draw();
    });

    var codValidator = $('#FormPlantilla').validate({
        rules: {
            txtCodUsuario: {
                required: true
            },
            txtNomUsuario: {
                required: true
            },
            txtCorreo: {
                required: true
            },
            txtDiaExpClave: {
                required: true
            },
            ddlPerfil: {
                required: true
            },
        },
        messages: {
            txtCodUsuario: {
                required: 'Ingrese Cod. Usuario'
            },
            txtNomUsuario: {
                required: 'Ingrese Nombre Usuario'
            },
            txtCorreo: {
                required: 'Ingrese Correo'
            },
            txtDiaExpClave: {
                required: 'Ingrese Dia Exp.'
            },
            ddlPerfil: {
                required: 'Ingrese un perfil'
            }
        },
        highlight: function (element) {
            $(element).parent().addClass('validation-error-label')
        },
        unhighlight: function (element) {
            $(element).parent().removeClass('validation-error-label')
        },

        submitHandler: function (form, e) {

            var _reply = CargarUsuario();
            var _url = '@Url.Action("EditUsuario", "SEG")';

            $.post(_url, _reply).done(function (data) {
                if (data.Status === 200) {
                    $('#editModal').modal('toggle');
                    toastr.success(data.Message);
                    UsuarioDatatable.draw();
                }
                else {
                    toastr.error(data.Message)
                }
            });
        }
    });

    function CargarUsuario() {

        //var isEstado = 0
        //if ($('#chkEstado').prop('checked')) {
        //    isEstado = 1;
        //}
        var isReset = 0
        if ($('#chkResetPassword').prop('checked')) {
            isReset = 1;
        }

        var arrDDL = [];
        var _ddl = $('#ddlPerfil').val();
        if (_ddl != null) {
            $.map(_ddl, function (item) {
                arrDDL.push(item);
            });
        }

        var _obj = {
            IDE_USUARIO: gAccion == "DELETE" ? gCod : $("#txtId").val(),
            COD_USUARIO: $('#txtCodUsuario').val(),
            NOM_USUARIO: $('#txtNomUsuario').val(),
            CORREO_ELECTRONICO: $("#txtCorreo").val(),
            diaExpiracionClave: $("#txtDiaExpClave").val(),
            estUsuario: $("#ddlEstado option:selected").val(),
            resetPassword: isReset,
            codPerfilRol: arrDDL.join(',')
        };

        var _reply = {
            ACCION: gAccion,
            MENSAJE: '',
            IDE_USUARIO: 0,
            DATA: JSON.stringify(_obj),
        };

        return _reply;
    }

    @*$("#btnEliminar").click(function () {

        var _reply = CargarUsuario();
        var _url = '@Url.Action("Edit_Usuario", "SEG")';

        $.post(_url, _reply).done(function (data) {
            if (data.Status === 200) {
                $('#ConfirmarModal').modal('toggle');
                toastr.success(data.Message);
                UsuarioDatatable.draw();
            }
            else {
                toastr.error(data.Message)
            }
        });
    });*@

});


    </script>
}